    <uri name="https://chevp.github.io/synth-protocol/schema/synth/routes/1.0"
         uri="synth/routes/1.0/routes.xsd"/>

    <uri name="https://chevp.github.io/synth-protocol/schema/synth/runtime/1.0"
         uri="synth/runtime/1.0/runtime.xsd"/>

    <uri name="https://chevp.github.io/synth-protocol/schema/synth/runtime/1.0/renderer"
