<?xml version="1.0" encoding="UTF-8"?>
<!--
    SYNTH ALL-IN-ONE SCHEMA
    Imports the unified synth.xsd which provides a single <synth> root element.
    Use this as the fileAssociation for *.synth, *.synth.xml, *.frost.xml, *.cryo.xml, and *.nuna.xml files.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Unified: <synth> root with child elements (project, scene, component, etc.) -->
    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/1.0"
               schemaLocation="synth.xsd"/>

</xs:schema>
