{
    "$comment": "Component: config | Content-Type: application/json",
    "component_type": "game_settings",
    "version": "1.0",

    "graphics": {
        "resolution": [1920, 1080],
        "fullscreen": false,
        "vsync": true,
        "shadowQuality": "high",
        "antiAliasing": "MSAA4x",
        "textureQuality": "high",
        "viewDistance": 1000
    },

    "audio": {
        "masterVolume": 0.8,
        "musicVolume": 0.6,
        "sfxVolume": 1.0,
        "voiceVolume": 1.0,
        "spatialAudio": true
    },

    "input": {
        "mouseSensitivity": 1.0,
        "invertY": false,
        "keybindings": {
            "moveForward": "W",
            "moveBack": "S",
            "moveLeft": "A",
            "moveRight": "D",
            "jump": "Space",
            "sprint": "LeftShift",
            "interact": "E",
            "inventory": "I"
        }
    },

    "gameplay": {
        "difficulty": "normal",
        "showTutorials": true,
        "autoSave": true,
        "autoSaveInterval": 300
    }
}
