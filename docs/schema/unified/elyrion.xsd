<?xml version="1.0" encoding="UTF-8"?>
<!--
    Elyrion Scene Schema (elyrion.xsd)

    Defines the elyrion format for frost-studio C++ Vulkan rendering.
    This is a simplified scene format optimized for real-time rendering.

    Root element: <elyrion>
    File extension: .elyrion

    Compatible with: frost-studio, synth-sdk elyrion export
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/unified/elyrion/1.0"
           xmlns:e="https://chevp.github.io/synth-protocol/schema/unified/elyrion/1.0"
           elementFormDefault="qualified">

    <!-- =================================================================== -->
    <!-- ROOT ELEMENT                                                        -->
    <!-- =================================================================== -->

    <xs:element name="elyrion" type="e:ElyrionSceneType"/>

    <xs:complexType name="ElyrionSceneType">
        <xs:sequence>
            <xs:element name="name" type="xs:string" minOccurs="0"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="entryScene" type="xs:string" minOccurs="0"/>
            <xs:element name="assets" type="e:AssetsContainerType" minOccurs="0"/>
            <xs:element name="scenes" type="e:ScenesContainerType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="version" type="xs:string" default="1.0.0"/>
        <xs:attribute name="author" type="xs:string"/>
    </xs:complexType>

    <!-- =================================================================== -->
    <!-- ASSETS                                                              -->
    <!-- =================================================================== -->

    <xs:complexType name="AssetsContainerType">
        <xs:sequence>
            <xs:element name="asset" type="e:AssetType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AssetType">
        <xs:sequence>
            <xs:element name="meta" minOccurs="0">
                <xs:complexType>
                    <xs:attribute name="type" type="xs:string"/>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="src" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- =================================================================== -->
    <!-- SCENES                                                              -->
    <!-- =================================================================== -->

    <xs:complexType name="ScenesContainerType">
        <xs:sequence>
            <xs:element name="scene" type="e:SceneType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SceneType">
        <xs:sequence>
            <xs:element name="entities" type="e:EntitiesContainerType" minOccurs="0"/>
            <xs:element name="camera" type="e:CameraType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="name" type="xs:string"/>
    </xs:complexType>

    <!-- =================================================================== -->
    <!-- ENTITIES                                                            -->
    <!-- =================================================================== -->

    <xs:complexType name="EntitiesContainerType">
        <xs:sequence>
            <xs:element name="entity" type="e:EntityType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="EntityType">
        <xs:sequence>
            <xs:element name="pos" type="e:Vec3Type" minOccurs="0"/>
            <xs:element name="rot" type="e:Vec3Type" minOccurs="0"/>
            <xs:element name="scale" type="e:Vec3Type" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="asset" type="xs:string"/>
        <xs:attribute name="type" type="xs:string" default="model"/>
    </xs:complexType>

    <!-- =================================================================== -->
    <!-- CAMERA                                                              -->
    <!-- =================================================================== -->

    <xs:complexType name="CameraType">
        <xs:sequence>
            <xs:element name="pos" type="e:Vec3Type" minOccurs="0"/>
            <xs:element name="rot" type="e:Vec3Type" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="type" type="xs:string" default="LOOK_AT"/>
        <xs:attribute name="fov" type="xs:float" default="60"/>
        <xs:attribute name="znear" type="xs:float" default="0.1"/>
        <xs:attribute name="zfar" type="xs:float" default="100"/>
    </xs:complexType>

    <!-- =================================================================== -->
    <!-- COMMON TYPES                                                        -->
    <!-- =================================================================== -->

    <xs:complexType name="Vec3Type">
        <xs:attribute name="x" type="xs:float" default="0"/>
        <xs:attribute name="y" type="xs:float" default="0"/>
        <xs:attribute name="z" type="xs:float" default="0"/>
    </xs:complexType>

</xs:schema>
