<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:world="https://chevp.github.io/synth-protocol/schema/synth/world/1.0"
           xmlns:common="https://chevp.github.io/synth-protocol/schema/synth/common-types"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/world/1.0"
           elementFormDefault="qualified">

    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/common-types"
               schemaLocation="../../common-types.xsd"/>

    <!-- =========================================================================
         SYNTH WORLD / STREAMING SCHEMA
         Terrain-Definition + Tile/Chunk-Streaming für große Welten.
         Root element: <synthWorld>
         ========================================================================= -->

    <xs:element name="synth-world" type="world:SynthWorldType"/>

    <xs:complexType name="SynthWorldType">
        <xs:sequence>
            <xs:element name="bounds" type="world:BoundsType"/>
            <xs:element name="terrain" type="world:TerrainType" minOccurs="0"/>
            <xs:element name="tiles" type="world:TilesType" minOccurs="0"/>
            <xs:element name="streaming" type="world:StreamingType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" use="required"/>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="origin-mode" type="world:OriginModeEnum" default="absolute"/>
    </xs:complexType>

    <xs:simpleType name="OriginModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="absolute"/>
            <xs:enumeration value="floatingOrigin"/>
            <xs:enumeration value="doublePrecision"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="BoundsType">
        <xs:sequence>
            <xs:element name="min" type="common:Vec3Type"/>
            <xs:element name="max" type="common:Vec3Type"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ===== Terrain ===== -->
    <xs:complexType name="TerrainType">
        <xs:sequence>
            <xs:element name="layer" type="world:TerrainLayerType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="heightmap" type="xs:string"/>
        <xs:attribute name="resolution" type="xs:int" default="1024"/>
        <xs:attribute name="cell-size" type="xs:float" default="1.0"/>
        <xs:attribute name="max-height" type="xs:float" default="500"/>
        <xs:attribute name="lod-mode" type="world:LODModeEnum" default="clipmap"/>
    </xs:complexType>

    <xs:simpleType name="LODModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="none"/>
            <xs:enumeration value="quadtree"/>
            <xs:enumeration value="clipmap"/>
            <xs:enumeration value="cdlod"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="TerrainLayerType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="material-ref" type="xs:string" use="required"/>
        <xs:attribute name="splat-map" type="xs:string"/>
        <xs:attribute name="splat-channel" type="world:SplatChannelEnum"/>
        <xs:attribute name="tiling-x" type="xs:float" default="1.0"/>
        <xs:attribute name="tiling-y" type="xs:float" default="1.0"/>
    </xs:complexType>

    <xs:simpleType name="SplatChannelEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="r"/>
            <xs:enumeration value="g"/>
            <xs:enumeration value="b"/>
            <xs:enumeration value="a"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Tiles / Chunks ===== -->
    <xs:complexType name="TilesType">
        <xs:sequence>
            <xs:element name="tile" type="world:TileType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="size-x" type="xs:float" use="required"/>
        <xs:attribute name="size-z" type="xs:float" use="required"/>
        <xs:attribute name="index-mode" type="world:TileIndexModeEnum" default="grid"/>
    </xs:complexType>

    <xs:simpleType name="TileIndexModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="grid"/>
            <xs:enumeration value="hex"/>
            <xs:enumeration value="named"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="TileType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="x" type="xs:int" use="required"/>
        <xs:attribute name="z" type="xs:int" use="required"/>
        <xs:attribute name="scene-ref" type="xs:string"/>
        <xs:attribute name="lod0-uri" type="xs:anyURI"/>
        <xs:attribute name="lod1-uri" type="xs:anyURI"/>
        <xs:attribute name="lod2-uri" type="xs:anyURI"/>
        <xs:attribute name="impostor-uri" type="xs:anyURI"/>
    </xs:complexType>

    <!-- ===== Streaming Settings ===== -->
    <xs:complexType name="StreamingType">
        <xs:attribute name="load-radius" type="xs:float" default="200.0"/>
        <xs:attribute name="unload-radius" type="xs:float" default="300.0"/>
        <xs:attribute name="preload-ahead" type="xs:int" default="1"/>
        <xs:attribute name="max-concurrent-loads" type="xs:int" default="4"/>
        <xs:attribute name="use-impostors-beyond" type="xs:float"/>
        <xs:attribute name="strategy" type="world:StreamingStrategyEnum" default="distance"/>
        <xs:attribute name="cache-policy" type="world:CachePolicyEnum" default="lru"/>
        <xs:attribute name="cache-size-mb" type="xs:int" default="512"/>
    </xs:complexType>

    <xs:simpleType name="StreamingStrategyEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="distance"/>
            <xs:enumeration value="visibility"/>
            <xs:enumeration value="predictive"/>
            <xs:enumeration value="manual"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CachePolicyEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="lru"/>
            <xs:enumeration value="fifo"/>
            <xs:enumeration value="priority"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
