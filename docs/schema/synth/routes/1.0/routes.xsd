<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:routes="https://chevp.github.io/synth-protocol/schema/synth/routes/1.0"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/routes/1.0"
           elementFormDefault="qualified">

    <!-- =========================================================================
         SYNTH ROUTES SCHEMA (v1.2)
         Scene routing configuration (like Angular Router)
         Root element: <synthRoutes>

         v1.1: Guards (canActivate, canDeactivate) + Resolvers (resolve)
         v1.2: Lazy-Loading-Marker pro Route (eager/lazy/streamed Assets)
         ========================================================================= -->

    <!-- Root Element -->
    <xs:element name="synthRoutes" type="routes:SynthRoutesType"/>

    <!-- Routes Container -->
    <xs:complexType name="SynthRoutesType">
        <xs:sequence>
            <xs:element name="route" type="routes:RouteType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Route Definition -->
    <xs:complexType name="RouteType">
        <xs:sequence>
            <!-- Scene Reference -->
            <xs:element name="scene" type="routes:SceneRefType"/>

            <!-- Spawn Points -->
            <xs:element name="spawnPoint" type="routes:SpawnPointType" minOccurs="1" maxOccurs="unbounded"/>

            <!-- Route Parameters (optional) -->
            <xs:element name="params" type="routes:ParamsType" minOccurs="0"/>

            <!-- v1.1: Guards & Resolvers -->
            <xs:element name="guards" type="routes:GuardsType" minOccurs="0"/>
            <xs:element name="resolvers" type="routes:ResolversType" minOccurs="0"/>

            <!-- v1.2: Loading-Strategie pro Asset/Asset-Gruppe -->
            <xs:element name="loading" type="routes:LoadingType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="path" type="xs:string" use="required"/>
        <xs:attribute name="default" type="xs:boolean" default="false"/>
        <!-- v1.2: Globale Strategie für diese Route (überschreibbar pro <load>) -->
        <xs:attribute name="loadStrategy" type="routes:LoadStrategyEnum" default="eager"/>
    </xs:complexType>

    <!-- ===== Loading (v1.2) ===== -->
    <xs:complexType name="LoadingType">
        <xs:sequence>
            <xs:element name="load" type="routes:LoadDirectiveType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LoadDirectiveType">
        <!-- URI oder Asset-ID oder Package-ID -->
        <xs:attribute name="ref" type="xs:string" use="required"/>
        <xs:attribute name="strategy" type="routes:LoadStrategyEnum" use="required"/>
        <xs:attribute name="priority" type="xs:int" default="0"/>
        <!-- Für streamed: Aktivierungs-Radius/Distanz -->
        <xs:attribute name="streamRadius" type="xs:float"/>
        <!-- Für preload: maximale Wartezeit in ms, sonst weiter ohne -->
        <xs:attribute name="preloadTimeoutMs" type="xs:int"/>
    </xs:complexType>

    <xs:simpleType name="LoadStrategyEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="eager"/>      <!-- Vor Route-Aktivierung komplett -->
            <xs:enumeration value="preload"/>    <!-- Parallel laden, Route startet sofort -->
            <xs:enumeration value="lazy"/>       <!-- Erst bei First-Use -->
            <xs:enumeration value="streamed"/>   <!-- Distanz-/Sichtbarkeits-basiert -->
            <xs:enumeration value="ondemand"/>   <!-- Nur via expliziten Service-Call -->
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Guards (v1.1) =====
         Verhindern oder erlauben Route-Übergänge. ServiceRef zeigt auf
         einen synthServices-Service, der die Guard-Methode bereitstellt. -->
    <xs:complexType name="GuardsType">
        <xs:sequence>
            <xs:element name="canActivate" type="routes:GuardRefType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="canDeactivate" type="routes:GuardRefType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="canLoad" type="routes:GuardRefType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="GuardRefType">
        <xs:attribute name="serviceRef" type="xs:string" use="required"/>
        <xs:attribute name="method" type="xs:string" use="required"/>
        <!-- "deny", "redirect", or "back" -->
        <xs:attribute name="onFail" type="routes:GuardFailEnum" default="deny"/>
        <xs:attribute name="redirectTo" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="GuardFailEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="deny"/>
            <xs:enumeration value="redirect"/>
            <xs:enumeration value="back"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Resolvers (v1.1) =====
         Werden VOR Route-Aktivierung ausgeführt und liefern Daten
         (z.B. Save-Slot laden, World-State holen, Loadscreen rendern). -->
    <xs:complexType name="ResolversType">
        <xs:sequence>
            <xs:element name="resolve" type="routes:ResolverRefType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ResolverRefType">
        <xs:attribute name="key" type="xs:string" use="required"/>
        <xs:attribute name="serviceRef" type="xs:string" use="required"/>
        <xs:attribute name="method" type="xs:string" use="required"/>
        <xs:attribute name="timeoutMs" type="xs:int" default="30000"/>
        <xs:attribute name="required" type="xs:boolean" default="true"/>
    </xs:complexType>

    <!-- Scene Reference -->
    <xs:complexType name="SceneRefType">
        <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Spawn Point -->
    <xs:complexType name="SpawnPointType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="x" type="xs:float" use="required"/>
        <xs:attribute name="y" type="xs:float" use="required"/>
        <xs:attribute name="z" type="xs:float" use="required"/>
    </xs:complexType>

    <!-- Route Parameters -->
    <xs:complexType name="ParamsType">
        <xs:sequence>
            <xs:element name="param" type="routes:ParamType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Parameter Definition -->
    <xs:complexType name="ParamType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="type" type="routes:ParamTypeEnum" use="required"/>
        <xs:attribute name="required" type="xs:boolean" default="false"/>
    </xs:complexType>

    <!-- Parameter Type Enumeration -->
    <xs:simpleType name="ParamTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="string"/>
            <xs:enumeration value="int"/>
            <xs:enumeration value="float"/>
            <xs:enumeration value="bool"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
