<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vfx="https://chevp.github.io/synth-protocol/schema/synth/vfx/1.0"
           xmlns:common="https://chevp.github.io/synth-protocol/schema/synth/common-types"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/vfx/1.0"
           elementFormDefault="qualified">

    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/common-types"
               schemaLocation="../../common-types.xsd"/>

    <!-- =========================================================================
         SYNTH VFX / PARTICLES SCHEMA
         Particle-Systems: Emitter, Shape, Forces, Module-Stack, Trails.
         Root element: <synthParticles>
         ========================================================================= -->

    <xs:element name="synthParticles" type="vfx:SynthParticlesType"/>

    <xs:complexType name="SynthParticlesType">
        <xs:sequence>
            <xs:element name="emitter" type="vfx:EmitterType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" use="required"/>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="EmitterType">
        <xs:sequence>
            <xs:element name="main" type="vfx:MainModuleType"/>
            <xs:element name="shape" type="vfx:ShapeModuleType" minOccurs="0"/>
            <xs:element name="emission" type="vfx:EmissionModuleType" minOccurs="0"/>
            <xs:element name="velocity" type="vfx:VelocityModuleType" minOccurs="0"/>
            <xs:element name="force" type="vfx:ForceModuleType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="colorOverLifetime" type="vfx:GradientType" minOccurs="0"/>
            <xs:element name="sizeOverLifetime" type="vfx:CurveType" minOccurs="0"/>
            <xs:element name="rotationOverLifetime" type="vfx:CurveType" minOccurs="0"/>
            <xs:element name="render" type="vfx:RenderModuleType"/>
            <xs:element name="trail" type="vfx:TrailModuleType" minOccurs="0"/>
            <xs:element name="collision" type="vfx:CollisionModuleType" minOccurs="0"/>
            <xs:element name="subEmitter" type="vfx:SubEmitterType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- ===== Main ===== -->
    <xs:complexType name="MainModuleType">
        <xs:attribute name="duration" type="xs:float" default="5.0"/>
        <xs:attribute name="loop" type="xs:boolean" default="true"/>
        <xs:attribute name="prewarm" type="xs:boolean" default="false"/>
        <xs:attribute name="startDelay" type="xs:float" default="0.0"/>
        <xs:attribute name="startLifetime" type="xs:float" default="2.0"/>
        <xs:attribute name="startSpeed" type="xs:float" default="1.0"/>
        <xs:attribute name="startSize" type="xs:float" default="0.1"/>
        <xs:attribute name="startColor" type="xs:string" default="#FFFFFF"/>
        <xs:attribute name="gravityModifier" type="xs:float" default="0.0"/>
        <xs:attribute name="simulationSpace" type="vfx:SimulationSpaceEnum" default="local"/>
        <xs:attribute name="maxParticles" type="xs:int" default="1000"/>
    </xs:complexType>

    <xs:simpleType name="SimulationSpaceEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="local"/>
            <xs:enumeration value="world"/>
            <xs:enumeration value="custom"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Shape ===== -->
    <xs:complexType name="ShapeModuleType">
        <xs:attribute name="type" type="vfx:ShapeTypeEnum" default="cone"/>
        <xs:attribute name="radius" type="xs:float" default="1.0"/>
        <xs:attribute name="angle" type="xs:float" default="25.0"/>
        <xs:attribute name="length" type="xs:float" default="5.0"/>
        <xs:attribute name="arcDeg" type="xs:float" default="360.0"/>
        <xs:attribute name="emitFromShell" type="xs:boolean" default="false"/>
        <xs:attribute name="meshRef" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="ShapeTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="point"/>
            <xs:enumeration value="sphere"/>
            <xs:enumeration value="hemisphere"/>
            <xs:enumeration value="cone"/>
            <xs:enumeration value="box"/>
            <xs:enumeration value="circle"/>
            <xs:enumeration value="edge"/>
            <xs:enumeration value="mesh"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Emission ===== -->
    <xs:complexType name="EmissionModuleType">
        <xs:sequence>
            <xs:element name="burst" type="vfx:BurstType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="rateOverTime" type="xs:float" default="10.0"/>
        <xs:attribute name="rateOverDistance" type="xs:float" default="0.0"/>
    </xs:complexType>

    <xs:complexType name="BurstType">
        <xs:attribute name="time" type="xs:float" default="0.0"/>
        <xs:attribute name="count" type="xs:int" use="required"/>
        <xs:attribute name="cycles" type="xs:int" default="1"/>
        <xs:attribute name="interval" type="xs:float" default="0.01"/>
        <xs:attribute name="probability" type="xs:float" default="1.0"/>
    </xs:complexType>

    <!-- ===== Velocity ===== -->
    <xs:complexType name="VelocityModuleType">
        <xs:sequence>
            <xs:element name="linear" type="common:Vec3Type" minOccurs="0"/>
            <xs:element name="orbital" type="common:Vec3Type" minOccurs="0"/>
            <xs:element name="radial" type="xs:float" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="space" type="vfx:SimulationSpaceEnum" default="local"/>
    </xs:complexType>

    <!-- ===== Forces (Wind, Gravity-Wells, Turbulence) ===== -->
    <xs:complexType name="ForceModuleType">
        <xs:sequence>
            <xs:element name="direction" type="common:Vec3Type" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="type" type="vfx:ForceTypeEnum" use="required"/>
        <xs:attribute name="strength" type="xs:float" default="1.0"/>
        <xs:attribute name="turbulenceFreq" type="xs:float"/>
    </xs:complexType>

    <xs:simpleType name="ForceTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="constant"/>
            <xs:enumeration value="vortex"/>
            <xs:enumeration value="drag"/>
            <xs:enumeration value="turbulence"/>
            <xs:enumeration value="pointAttract"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Gradients / Curves (vereinfacht) ===== -->
    <xs:complexType name="GradientType">
        <xs:sequence>
            <xs:element name="key" type="vfx:GradientKeyType" minOccurs="2" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="GradientKeyType">
        <xs:attribute name="t" type="xs:float" use="required"/>
        <xs:attribute name="color" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="CurveType">
        <xs:sequence>
            <xs:element name="key" type="vfx:CurveKeyType" minOccurs="2" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CurveKeyType">
        <xs:attribute name="t" type="xs:float" use="required"/>
        <xs:attribute name="value" type="xs:float" use="required"/>
    </xs:complexType>

    <!-- ===== Render ===== -->
    <xs:complexType name="RenderModuleType">
        <xs:attribute name="mode" type="vfx:RenderModeEnum" default="billboard"/>
        <xs:attribute name="materialRef" type="xs:string" use="required"/>
        <xs:attribute name="meshRef" type="xs:string"/>
        <xs:attribute name="sortMode" type="vfx:SortModeEnum" default="none"/>
        <xs:attribute name="alignment" type="vfx:AlignmentEnum" default="view"/>
    </xs:complexType>

    <xs:simpleType name="RenderModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="billboard"/>
            <xs:enumeration value="stretchedBillboard"/>
            <xs:enumeration value="horizontalBillboard"/>
            <xs:enumeration value="verticalBillboard"/>
            <xs:enumeration value="mesh"/>
            <xs:enumeration value="ribbon"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="SortModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="none"/>
            <xs:enumeration value="byDistance"/>
            <xs:enumeration value="oldestFirst"/>
            <xs:enumeration value="youngestFirst"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AlignmentEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="view"/>
            <xs:enumeration value="world"/>
            <xs:enumeration value="velocity"/>
            <xs:enumeration value="local"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Trail / Collision / SubEmitter ===== -->
    <xs:complexType name="TrailModuleType">
        <xs:attribute name="lifetimeMultiplier" type="xs:float" default="1.0"/>
        <xs:attribute name="ratio" type="xs:float" default="1.0"/>
        <xs:attribute name="minVertexDistance" type="xs:float" default="0.2"/>
        <xs:attribute name="materialRef" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="CollisionModuleType">
        <xs:attribute name="type" type="vfx:CollisionTypeEnum" default="world"/>
        <xs:attribute name="dampen" type="xs:float" default="0.5"/>
        <xs:attribute name="bounce" type="xs:float" default="0.5"/>
        <xs:attribute name="lifetimeLoss" type="xs:float" default="0.0"/>
        <xs:attribute name="layerMask" type="xs:string" default="*"/>
    </xs:complexType>

    <xs:simpleType name="CollisionTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="none"/>
            <xs:enumeration value="world"/>
            <xs:enumeration value="planes"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="SubEmitterType">
        <xs:attribute name="trigger" type="vfx:SubEmitterTriggerEnum" use="required"/>
        <xs:attribute name="emitterRef" type="xs:string" use="required"/>
        <xs:attribute name="probability" type="xs:float" default="1.0"/>
    </xs:complexType>

    <xs:simpleType name="SubEmitterTriggerEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="birth"/>
            <xs:enumeration value="collision"/>
            <xs:enumeration value="death"/>
            <xs:enumeration value="trigger"/>
            <xs:enumeration value="manual"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
