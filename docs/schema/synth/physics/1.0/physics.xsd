<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:physics="https://chevp.github.io/synth-protocol/schema/synth/physics/1.0"
           xmlns:common="https://chevp.github.io/synth-protocol/schema/synth/common-types"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/physics/1.0"
           elementFormDefault="qualified">

    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/common-types"
               schemaLocation="../../common-types.xsd"/>

    <!-- =========================================================================
         SYNTH PHYSICS SCHEMA
         Engine-agnostische Daten (Bullet/PhysX/Jolt entscheidet der Renderer).
         Root element: <synthPhysics>
         ========================================================================= -->

    <xs:element name="synthPhysics" type="physics:SynthPhysicsType"/>

    <xs:complexType name="SynthPhysicsType">
        <xs:sequence>
            <xs:element name="world" type="physics:WorldType" minOccurs="0"/>
            <xs:element name="layers" type="physics:LayersType" minOccurs="0"/>
            <xs:element name="materials" type="physics:MaterialsType" minOccurs="0"/>
            <xs:element name="bodies" type="physics:BodiesType" minOccurs="0"/>
            <xs:element name="joints" type="physics:JointsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" use="required"/>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- ===== World ===== -->
    <xs:complexType name="WorldType">
        <xs:sequence>
            <xs:element name="gravity" type="common:Vec3Type" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="fixedTimestepHz" type="xs:int" default="60"/>
        <xs:attribute name="maxSubSteps" type="xs:int" default="8"/>
        <xs:attribute name="solverIterations" type="xs:int" default="10"/>
    </xs:complexType>

    <!-- ===== Layer-Matrix ===== -->
    <xs:complexType name="LayersType">
        <xs:sequence>
            <xs:element name="layer" type="physics:LayerType" maxOccurs="64"/>
            <xs:element name="collision" type="physics:CollisionPairType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="LayerType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="bit" type="xs:int" use="required"/>
    </xs:complexType>

    <xs:complexType name="CollisionPairType">
        <xs:attribute name="a" type="xs:string" use="required"/>
        <xs:attribute name="b" type="xs:string" use="required"/>
        <xs:attribute name="collide" type="xs:boolean" default="true"/>
    </xs:complexType>

    <!-- ===== Physics-Materials ===== -->
    <xs:complexType name="MaterialsType">
        <xs:sequence>
            <xs:element name="material" type="physics:PhysicsMaterialType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PhysicsMaterialType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="friction" type="xs:float" default="0.5"/>
        <xs:attribute name="restitution" type="xs:float" default="0.0"/>
        <xs:attribute name="density" type="xs:float" default="1.0"/>
    </xs:complexType>

    <!-- ===== Bodies ===== -->
    <xs:complexType name="BodiesType">
        <xs:sequence>
            <xs:element name="body" type="physics:BodyType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BodyType">
        <xs:sequence>
            <xs:element name="collider" type="physics:ColliderType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <!-- Reference to an entity in a scene -->
        <xs:attribute name="entity" type="xs:string"/>
        <xs:attribute name="type" type="physics:BodyTypeEnum" use="required"/>
        <xs:attribute name="mass" type="xs:float" default="1.0"/>
        <xs:attribute name="linearDamping" type="xs:float" default="0.0"/>
        <xs:attribute name="angularDamping" type="xs:float" default="0.0"/>
        <xs:attribute name="gravityScale" type="xs:float" default="1.0"/>
        <xs:attribute name="ccd" type="xs:boolean" default="false"/>
        <xs:attribute name="layer" type="xs:string"/>
        <xs:attribute name="lockRotationX" type="xs:boolean" default="false"/>
        <xs:attribute name="lockRotationY" type="xs:boolean" default="false"/>
        <xs:attribute name="lockRotationZ" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:simpleType name="BodyTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="static"/>
            <xs:enumeration value="dynamic"/>
            <xs:enumeration value="kinematic"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Colliders ===== -->
    <xs:complexType name="ColliderType">
        <xs:sequence>
            <xs:element name="offset" type="common:Vec3Type" minOccurs="0"/>
            <xs:choice>
                <xs:element name="box" type="physics:BoxShapeType"/>
                <xs:element name="sphere" type="physics:SphereShapeType"/>
                <xs:element name="capsule" type="physics:CapsuleShapeType"/>
                <xs:element name="cylinder" type="physics:CylinderShapeType"/>
                <xs:element name="mesh" type="physics:MeshShapeType"/>
                <xs:element name="heightfield" type="physics:HeightfieldShapeType"/>
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="material" type="xs:string"/>
        <xs:attribute name="trigger" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:complexType name="BoxShapeType">
        <xs:attribute name="halfX" type="xs:float" use="required"/>
        <xs:attribute name="halfY" type="xs:float" use="required"/>
        <xs:attribute name="halfZ" type="xs:float" use="required"/>
    </xs:complexType>

    <xs:complexType name="SphereShapeType">
        <xs:attribute name="radius" type="xs:float" use="required"/>
    </xs:complexType>

    <xs:complexType name="CapsuleShapeType">
        <xs:attribute name="radius" type="xs:float" use="required"/>
        <xs:attribute name="height" type="xs:float" use="required"/>
        <xs:attribute name="axis" type="physics:AxisEnum" default="y"/>
    </xs:complexType>

    <xs:complexType name="CylinderShapeType">
        <xs:attribute name="radius" type="xs:float" use="required"/>
        <xs:attribute name="height" type="xs:float" use="required"/>
        <xs:attribute name="axis" type="physics:AxisEnum" default="y"/>
    </xs:complexType>

    <xs:complexType name="MeshShapeType">
        <xs:attribute name="ref" type="xs:string" use="required"/>
        <xs:attribute name="convex" type="xs:boolean" default="true"/>
    </xs:complexType>

    <xs:complexType name="HeightfieldShapeType">
        <xs:attribute name="ref" type="xs:string" use="required"/>
        <xs:attribute name="rows" type="xs:int" use="required"/>
        <xs:attribute name="cols" type="xs:int" use="required"/>
        <xs:attribute name="scaleX" type="xs:float" default="1.0"/>
        <xs:attribute name="scaleY" type="xs:float" default="1.0"/>
        <xs:attribute name="scaleZ" type="xs:float" default="1.0"/>
    </xs:complexType>

    <xs:simpleType name="AxisEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="x"/>
            <xs:enumeration value="y"/>
            <xs:enumeration value="z"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Joints ===== -->
    <xs:complexType name="JointsType">
        <xs:sequence>
            <xs:element name="joint" type="physics:JointType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="JointType">
        <xs:sequence>
            <xs:element name="anchorA" type="common:Vec3Type" minOccurs="0"/>
            <xs:element name="anchorB" type="common:Vec3Type" minOccurs="0"/>
            <xs:element name="axis" type="common:Vec3Type" minOccurs="0"/>
            <xs:element name="limits" type="physics:JointLimitsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="type" type="physics:JointTypeEnum" use="required"/>
        <xs:attribute name="bodyA" type="xs:string" use="required"/>
        <xs:attribute name="bodyB" type="xs:string" use="required"/>
        <xs:attribute name="collideConnected" type="xs:boolean" default="false"/>
        <xs:attribute name="breakForce" type="xs:float"/>
    </xs:complexType>

    <xs:simpleType name="JointTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="fixed"/>
            <xs:enumeration value="hinge"/>
            <xs:enumeration value="slider"/>
            <xs:enumeration value="ball"/>
            <xs:enumeration value="distance"/>
            <xs:enumeration value="spring"/>
            <xs:enumeration value="6dof"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="JointLimitsType">
        <xs:attribute name="min" type="xs:float"/>
        <xs:attribute name="max" type="xs:float"/>
        <xs:attribute name="stiffness" type="xs:float"/>
        <xs:attribute name="damping" type="xs:float"/>
    </xs:complexType>

</xs:schema>
