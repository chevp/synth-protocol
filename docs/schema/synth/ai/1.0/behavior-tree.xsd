<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ai="https://chevp.github.io/synth-protocol/schema/synth/ai/1.0"
           xmlns:common="https://chevp.github.io/synth-protocol/schema/synth/common-types"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/ai/1.0"
           elementFormDefault="qualified">

    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/common-types"
               schemaLocation="../../common-types.xsd"/>

    <!-- =========================================================================
         SYNTH AI / BEHAVIOR-TREE SCHEMA
         Behavior Trees als generisches Steuerungsmodell für Agents.
         Ergänzt (nicht ersetzt) die generische StateMachineType aus component.xsd.

         Knotenarten:
         - Composite: Sequence, Selector, Parallel
         - Decorator: Inverter, Repeat, Cooldown, Wait
         - Leaf:      Action (Service-Call), Condition (Blackboard-Check)
         Root element: <synthBehaviorTree>
         ========================================================================= -->

    <xs:element name="synth-behavior-tree" type="ai:SynthBehaviorTreeType"/>

    <xs:complexType name="SynthBehaviorTreeType">
        <xs:sequence>
            <xs:element name="blackboard" type="ai:BlackboardType" minOccurs="0"/>
            <xs:element name="root" type="ai:BTNodeType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="version" type="xs:string" use="required"/>
        <xs:attribute name="tick-rate-hz" type="xs:int" default="10"/>
    </xs:complexType>

    <!-- Blackboard: geteilter Speicher zwischen BT-Knoten -->
    <xs:complexType name="BlackboardType">
        <xs:sequence>
            <xs:element name="key" type="ai:BlackboardKeyType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BlackboardKeyType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="type" type="common:PropertyTypeEnum" use="required"/>
        <xs:attribute name="default" type="xs:string"/>
    </xs:complexType>

    <!-- BT-Knoten (rekursiv) -->
    <xs:complexType name="BTNodeType">
        <xs:choice>
            <xs:element name="sequence" type="ai:CompositeNodeType"/>
            <xs:element name="selector" type="ai:CompositeNodeType"/>
            <xs:element name="parallel" type="ai:ParallelNodeType"/>
            <xs:element name="inverter" type="ai:DecoratorNodeType"/>
            <xs:element name="repeat" type="ai:RepeatNodeType"/>
            <xs:element name="cooldown" type="ai:CooldownNodeType"/>
            <xs:element name="wait" type="ai:WaitNodeType"/>
            <xs:element name="action" type="ai:ActionNodeType"/>
            <xs:element name="condition" type="ai:ConditionNodeType"/>
            <xs:element name="subtree" type="ai:SubtreeRefType"/>
        </xs:choice>
    </xs:complexType>

    <!-- Composite: führt Kinder sequentiell (sequence) oder bis Erfolg (selector) aus -->
    <xs:complexType name="CompositeNodeType">
        <xs:sequence>
            <xs:element name="child" type="ai:BTNodeType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string"/>
        <xs:attribute name="memory" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:complexType name="ParallelNodeType">
        <xs:sequence>
            <xs:element name="child" type="ai:BTNodeType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string"/>
        <xs:attribute name="success-threshold" type="xs:int" default="1"/>
        <xs:attribute name="failure-threshold" type="xs:int" default="1"/>
    </xs:complexType>

    <!-- Decorator: ein Kind, Verhalten modifiziert -->
    <xs:complexType name="DecoratorNodeType">
        <xs:sequence>
            <xs:element name="child" type="ai:BTNodeType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="RepeatNodeType">
        <xs:sequence>
            <xs:element name="child" type="ai:BTNodeType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string"/>
        <xs:attribute name="count" type="xs:int"/>
        <xs:attribute name="until-fail" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:complexType name="CooldownNodeType">
        <xs:sequence>
            <xs:element name="child" type="ai:BTNodeType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string"/>
        <xs:attribute name="seconds" type="xs:float" use="required"/>
    </xs:complexType>

    <xs:complexType name="WaitNodeType">
        <xs:attribute name="id" type="xs:string"/>
        <xs:attribute name="seconds" type="xs:float" use="required"/>
        <xs:attribute name="random" type="xs:float" default="0"/>
    </xs:complexType>

    <!-- Leaf: Action ruft Service auf, Condition prüft Blackboard -->
    <xs:complexType name="ActionNodeType">
        <xs:sequence>
            <xs:element name="param" type="ai:ParamType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string"/>
        <xs:attribute name="service-ref" type="xs:string" use="required"/>
        <xs:attribute name="method" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="ConditionNodeType">
        <xs:attribute name="id" type="xs:string"/>
        <!-- Expression on blackboard, e.g. "hp < 0.3" or "enemyVisible == true" -->
        <xs:attribute name="expr" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="ParamType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="value" type="xs:string"/>
        <!-- $blackboard.key, $entity, $target, ... -->
        <xs:attribute name="from" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="SubtreeRefType">
        <xs:attribute name="id" type="xs:string"/>
        <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>

</xs:schema>
