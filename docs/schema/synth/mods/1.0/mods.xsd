<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:mods="https://chevp.github.io/synth-protocol/schema/synth/mods/1.0"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/mods/1.0"
           elementFormDefault="qualified">

    <!-- =========================================================================
         SYNTH MODS / UGC SCHEMA
         User-Mods und Workshop-Content. Abgegrenzt von extension.xsd
         (das sind Engine-/Framework-Extensions, NICHT End-User-Mods).

         Zwei Sichten:
         - Manifest:  Beschreibung eines einzelnen Mods
         - Registry:  Liste von Mods (lokale Reihenfolge + Workshop-Listing)
         Root element: <synthMods>
         ========================================================================= -->

    <xs:element name="synth-mods" type="mods:SynthModsType"/>

    <xs:complexType name="SynthModsType">
        <xs:choice>
            <xs:element name="manifest" type="mods:ModManifestType"/>
            <xs:element name="registry" type="mods:ModRegistryType"/>
        </xs:choice>
        <xs:attribute name="version" type="xs:string" use="required"/>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- ===== Manifest (ein konkretes Mod) ===== -->
    <xs:complexType name="ModManifestType">
        <xs:sequence>
            <xs:element name="meta" type="mods:ModMetaType"/>
            <xs:element name="compat" type="mods:CompatType"/>
            <xs:element name="dependencies" type="mods:ModDependenciesType" minOccurs="0"/>
            <xs:element name="conflicts" type="mods:ConflictsType" minOccurs="0"/>
            <xs:element name="provides" type="mods:ProvidesType" minOccurs="0"/>
            <xs:element name="hooks" type="mods:HooksType" minOccurs="0"/>
            <xs:element name="permissions" type="mods:PermissionsType" minOccurs="0"/>
            <xs:element name="content" type="mods:ContentType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ModMetaType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="version" type="xs:string"/>
            <xs:element name="author" type="xs:string" minOccurs="0"/>
            <xs:element name="url" type="xs:anyURI" minOccurs="0"/>
            <xs:element name="license" type="xs:string" minOccurs="0"/>
            <xs:element name="thumbnail" type="xs:string" minOccurs="0"/>
            <xs:element name="tags" type="mods:TagsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="TagsType">
        <xs:sequence>
            <xs:element name="tag" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CompatType">
        <xs:attribute name="min-host-version" type="xs:string" use="required"/>
        <xs:attribute name="max-host-version" type="xs:string"/>
        <xs:attribute name="api-level" type="xs:int" use="required"/>
    </xs:complexType>

    <xs:complexType name="ModDependenciesType">
        <xs:sequence>
            <xs:element name="depends-on" type="mods:ModRefType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="load-after" type="mods:ModRefType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="load-before" type="mods:ModRefType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ModRefType">
        <xs:attribute name="ref" type="xs:string" use="required"/>
        <xs:attribute name="min-version" type="xs:string"/>
        <xs:attribute name="optional" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:complexType name="ConflictsType">
        <xs:sequence>
            <xs:element name="conflict" type="mods:ModRefType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ProvidesType">
        <xs:sequence>
            <xs:element name="capability" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Hooks: Mount-Points, Patches, Overrides -->
    <xs:complexType name="HooksType">
        <xs:sequence>
            <xs:element name="override" type="mods:OverrideHookType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="patch" type="mods:PatchHookType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="extend" type="mods:ExtendHookType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="script" type="mods:ScriptHookType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="OverrideHookType">
        <xs:attribute name="target-uri" type="xs:anyURI" use="required"/>
        <xs:attribute name="with-uri" type="xs:anyURI" use="required"/>
    </xs:complexType>

    <xs:complexType name="PatchHookType">
        <xs:attribute name="target-uri" type="xs:anyURI" use="required"/>
        <xs:attribute name="patch-uri" type="xs:anyURI" use="required"/>
        <xs:attribute name="format" type="mods:PatchFormatEnum" default="json-patch"/>
    </xs:complexType>

    <xs:simpleType name="PatchFormatEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="json-patch"/>
            <xs:enumeration value="json-merge"/>
            <xs:enumeration value="xml-patch"/>
            <xs:enumeration value="diff"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="ExtendHookType">
        <xs:attribute name="extension-point" type="xs:string" use="required"/>
        <xs:attribute name="contribution-uri" type="xs:anyURI" use="required"/>
    </xs:complexType>

    <xs:complexType name="ScriptHookType">
        <xs:attribute name="event" type="xs:string" use="required"/>
        <xs:attribute name="uri" type="xs:anyURI" use="required"/>
        <xs:attribute name="lang" type="mods:ScriptLangEnum" default="lua"/>
    </xs:complexType>

    <xs:simpleType name="ScriptLangEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="lua"/>
            <xs:enumeration value="wasm"/>
            <xs:enumeration value="js"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Permissions: Sandbox-Berechtigungen (User-Mods sollten untrusted sein) -->
    <xs:complexType name="PermissionsType">
        <xs:sequence>
            <xs:element name="permission" type="mods:PermissionType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PermissionType">
        <xs:attribute name="type" type="mods:PermissionTypeEnum" use="required"/>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="reason" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="PermissionTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="filesystem-read"/>
            <xs:enumeration value="filesystem-write"/>
            <xs:enumeration value="network"/>
            <xs:enumeration value="ipc"/>
            <xs:enumeration value="services"/>
            <xs:enumeration value="native-code"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Content-Roots des Mods (für VFS-Mounting) -->
    <xs:complexType name="ContentType">
        <xs:sequence>
            <xs:element name="mount" type="mods:ContentMountType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ContentMountType">
        <xs:attribute name="path" type="xs:string" use="required"/>
        <xs:attribute name="as" type="xs:string"/>
        <xs:attribute name="priority" type="xs:int" default="0"/>
    </xs:complexType>

    <!-- ===== Registry (mehrere Mods, mit Lade-Reihenfolge) ===== -->
    <xs:complexType name="ModRegistryType">
        <xs:sequence>
            <xs:element name="entry" type="mods:RegistryEntryType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RegistryEntryType">
        <xs:attribute name="mod-id" type="xs:string" use="required"/>
        <xs:attribute name="version" type="xs:string"/>
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="order" type="xs:int"/>
        <xs:attribute name="source" type="mods:ModSourceEnum" default="local"/>
        <xs:attribute name="source-uri" type="xs:anyURI"/>
    </xs:complexType>

    <xs:simpleType name="ModSourceEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="local"/>
            <xs:enumeration value="workshop"/>
            <xs:enumeration value="url"/>
            <xs:enumeration value="builtin"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
