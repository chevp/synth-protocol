<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:pipeline="https://chevp.github.io/synth-protocol/schema/synth/pipeline/1.0"
           xmlns:common="https://chevp.github.io/synth-protocol/schema/synth/common-types"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/pipeline/1.0"
           elementFormDefault="qualified">

    <!-- Imports -->
    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/common-types"
               schemaLocation="../../common-types.xsd"/>

    <!-- =========================================================================
         SYNTH ASSET PIPELINE SCHEMA (.pipeline.nuna files)

         Standalone asset build pipelines executed by nuna-runtime.exe.
         Analogous to GitHub Actions workflows, but local.

         Usage:
           nuna-runtime.exe --pipeline build-world.pipeline.nuna
           (or double-click on .pipeline.nuna file with nuna-runtime association)

         Design Principles:
           - Each .pipeline.nuna file = one self-contained pipeline
           - Steps invoke CLI tools as subprocesses (no C++ required)
           - VFS mounts resolve asset:// and asset-src:// URIs
           - DAG execution: steps declare dependencies via dependsOn
           - Triggers: manual, file-watch, schedule, hub-event

         File Convention:
           synth-game/
           ├── pipelines/
           │   ├── build-world.pipeline.nuna
           │   ├── build-characters.pipeline.nuna
           │   ├── build-textures.pipeline.nuna
           │   └── full-build.pipeline.nuna
           └── scenes/
               └── ...
         ========================================================================= -->

    <!-- Root Element -->
    <xs:element name="synthAssetPipeline" type="pipeline:SynthAssetPipelineType"/>

    <!-- =========================================================================
         PIPELINE ROOT
         ========================================================================= -->

    <xs:complexType name="SynthAssetPipelineType">
        <xs:sequence>
            <!-- Pipeline metadata -->
            <xs:element name="metadata" type="pipeline:PipelineMetadataType"/>

            <!-- VFS mounts for asset resolution -->
            <xs:element name="mounts" type="pipeline:MountsType" minOccurs="0"/>

            <!-- Tool declarations (CLI tools used by steps) -->
            <xs:element name="tools" type="pipeline:ToolsType" minOccurs="0"/>

            <!-- Environment variables -->
            <xs:element name="env" type="pipeline:EnvType" minOccurs="0"/>

            <!-- Pipeline steps (DAG) -->
            <xs:element name="steps" type="pipeline:StepsType"/>

            <!-- Triggers: when this pipeline runs -->
            <xs:element name="triggers" type="pipeline:TriggersType" minOccurs="0"/>

            <!-- Settings -->
            <xs:element name="settings" type="common:SettingsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- =========================================================================
         PIPELINE METADATA
         ========================================================================= -->

    <xs:complexType name="PipelineMetadataType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="author" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- =========================================================================
         VFS MOUNTS
         Override or extend project-level mounts for this pipeline.
         ========================================================================= -->

    <xs:complexType name="MountsType">
        <xs:sequence>
            <xs:element name="mount" type="pipeline:MountType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MountType">
        <xs:attribute name="scheme" type="xs:string" use="required"/>
        <xs:attribute name="path" type="xs:string" use="required"/>
        <xs:attribute name="readOnly" type="xs:boolean" default="true"/>
    </xs:complexType>

    <!-- =========================================================================
         TOOL DECLARATIONS
         CLI tools invoked by steps. nuna-runtime resolves executables via PATH
         or explicit path. Tools are subprocesses, not C++ code.
         ========================================================================= -->

    <xs:complexType name="ToolsType">
        <xs:sequence>
            <xs:element name="tool" type="pipeline:ToolType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ToolType">
        <xs:sequence>
            <xs:element name="config" type="pipeline:ConfigMapType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="executable" type="xs:string" use="required"/>
        <xs:attribute name="version" type="xs:string"/>
    </xs:complexType>

    <!-- =========================================================================
         ENVIRONMENT VARIABLES
         ========================================================================= -->

    <xs:complexType name="EnvType">
        <xs:sequence>
            <xs:element name="var" type="pipeline:EnvVarType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="EnvVarType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- =========================================================================
         PIPELINE STEPS (DAG)
         Each step invokes a tool with input/output parameters.
         Steps form a DAG via dependsOn attributes.
         ========================================================================= -->

    <xs:complexType name="StepsType">
        <xs:sequence>
            <xs:element name="step" type="pipeline:StepType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StepType">
        <xs:sequence>
            <!-- Input parameters -->
            <xs:element name="input" type="pipeline:ParamsType" minOccurs="0"/>

            <!-- Output parameters -->
            <xs:element name="output" type="pipeline:ParamsType" minOccurs="0"/>

            <!-- Tool-specific configuration -->
            <xs:element name="config" type="pipeline:ConfigMapType" minOccurs="0"/>

            <!-- Condition: only run if expression evaluates true -->
            <xs:element name="condition" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="tool" type="xs:string" use="required"/>
        <xs:attribute name="dependsOn" type="xs:string"/>
        <xs:attribute name="timeout" type="xs:int"/>
        <xs:attribute name="continueOnError" type="xs:boolean" default="false"/>
    </xs:complexType>

    <!-- =========================================================================
         PARAMETERS (Input/Output)
         Support asset:// URIs resolved via mounts.
         ========================================================================= -->

    <xs:complexType name="ParamsType">
        <xs:sequence>
            <xs:element name="param" type="pipeline:ParamType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ParamType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="name" type="xs:string" use="required"/>
                <xs:attribute name="type" type="pipeline:ParamDataType"/>
                <!-- ref: reference output of another step (e.g., "export.output.target") -->
                <xs:attribute name="ref" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:simpleType name="ParamDataType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="file"/>
            <xs:enumeration value="directory"/>
            <xs:enumeration value="string"/>
            <xs:enumeration value="glob"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- =========================================================================
         TRIGGERS
         ========================================================================= -->

    <xs:complexType name="TriggersType">
        <xs:sequence>
            <xs:element name="trigger" type="pipeline:TriggerType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="TriggerType">
        <xs:attribute name="type" type="pipeline:TriggerTypeEnum" use="required"/>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="pattern" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="TriggerTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="manual"/>
            <xs:enumeration value="file-watch"/>
            <xs:enumeration value="schedule"/>
            <xs:enumeration value="hub-event"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- =========================================================================
         CONFIG MAP (local type)
         ========================================================================= -->

    <xs:complexType name="ConfigMapType">
        <xs:sequence>
            <xs:element name="entry" type="pipeline:ConfigEntryType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ConfigEntryType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="key" type="xs:string" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

</xs:schema>
