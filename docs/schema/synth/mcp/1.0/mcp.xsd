<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:mcp="https://chevp.github.io/synth-protocol/schema/synth/mcp/1.0"
           xmlns:core="https://chevp.github.io/synth-protocol/schema/synth/core/1.0"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/mcp/1.0"
           elementFormDefault="qualified">

    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/core/1.0" schemaLocation="../core/1.0/core.xsd"/>

    <!-- =========================================================================
         SYNTH MCP SCHEMA
         Model Context Protocol configuration for AI tool integration
         ========================================================================= -->

    <!-- MCP Servers Root Element -->
    <xs:element name="servers" type="mcp:ServersType"/>

    <!-- Servers Configuration -->
    <xs:complexType name="ServersType">
        <xs:sequence>
            <xs:element name="server" type="mcp:ServerType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- MCP Server Definition -->
    <xs:complexType name="ServerType">
        <xs:sequence>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="transport" type="mcp:TransportType"/>
            <xs:element name="tools" type="mcp:ToolsType" minOccurs="0"/>
            <xs:element name="resources" type="mcp:ResourcesType" minOccurs="0"/>
            <xs:element name="prompts" type="mcp:PromptsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="version" type="xs:string"/>
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
    </xs:complexType>

    <!-- Transport Configuration -->
    <xs:complexType name="TransportType">
        <xs:choice>
            <xs:element name="stdio" type="mcp:StdioTransportType"/>
            <xs:element name="http" type="mcp:HttpTransportType"/>
            <xs:element name="sse" type="mcp:SseTransportType"/>
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="StdioTransportType">
        <xs:sequence>
            <xs:element name="command" type="xs:string"/>
            <xs:element name="args" type="mcp:ArgsType" minOccurs="0"/>
            <xs:element name="env" type="mcp:EnvType" minOccurs="0"/>
            <xs:element name="work-dir" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="HttpTransportType">
        <xs:sequence>
            <xs:element name="base-url" type="xs:anyURI"/>
            <xs:element name="headers" type="mcp:HeadersType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="timeout" type="xs:int" default="30000"/>
    </xs:complexType>

    <xs:complexType name="SseTransportType">
        <xs:sequence>
            <xs:element name="url" type="xs:anyURI"/>
            <xs:element name="headers" type="mcp:HeadersType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ArgsType">
        <xs:sequence>
            <xs:element name="arg" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="EnvType">
        <xs:sequence>
            <xs:element name="var" type="mcp:EnvVarType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="EnvVarType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="HeadersType">
        <xs:sequence>
            <xs:element name="header" type="mcp:HeaderType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="HeaderType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- MCP Tools -->
    <xs:complexType name="ToolsType">
        <xs:sequence>
            <xs:element name="tool" type="mcp:ToolType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ToolType">
        <xs:sequence>
            <xs:element name="description" type="xs:string"/>
            <xs:element name="input-schema" type="mcp:JsonSchemaType"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="JsonSchemaType">
        <xs:sequence>
            <xs:element name="properties" type="mcp:PropertiesType" minOccurs="0"/>
            <xs:element name="required" type="mcp:RequiredType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="type" type="xs:string" default="object"/>
    </xs:complexType>

    <xs:complexType name="PropertiesType">
        <xs:sequence>
            <xs:element name="property" type="mcp:PropertyType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PropertyType">
        <xs:sequence>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="enum" type="mcp:EnumType" minOccurs="0"/>
            <xs:element name="default" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="type" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="EnumType">
        <xs:sequence>
            <xs:element name="value" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RequiredType">
        <xs:sequence>
            <xs:element name="field" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- MCP Resources -->
    <xs:complexType name="ResourcesType">
        <xs:sequence>
            <xs:element name="resource" type="mcp:ResourceType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ResourceType">
        <xs:sequence>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="uri" type="xs:anyURI" use="required"/>
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="mime-type" type="xs:string"/>
    </xs:complexType>

    <!-- MCP Prompts -->
    <xs:complexType name="PromptsType">
        <xs:sequence>
            <xs:element name="prompt" type="mcp:PromptType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PromptType">
        <xs:sequence>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="arguments" type="mcp:ArgumentsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="ArgumentsType">
        <xs:sequence>
            <xs:element name="argument" type="mcp:ArgumentType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ArgumentType">
        <xs:sequence>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="required" type="xs:boolean" default="false"/>
    </xs:complexType>

</xs:schema>
