<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:postfx="https://chevp.github.io/synth-protocol/schema/synth/postfx/1.0"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/postfx/1.0"
           elementFormDefault="qualified">

    <!-- =========================================================================
         SYNTH POST-PROCESSING SCHEMA
         Render-Pipeline-Post-FX Volumes: Bloom, SSAO, DoF, Motion-Blur,
         Color-Grading, Tonemapping, Vignette, Chromatic-Aberration, Film-Grain.
         Root element: <synthPostFX>
         ========================================================================= -->

    <xs:element name="synthPostFX" type="postfx:SynthPostFXType"/>

    <xs:complexType name="SynthPostFXType">
        <xs:sequence>
            <xs:element name="profile" type="postfx:ProfileType" maxOccurs="unbounded"/>
            <xs:element name="volume" type="postfx:VolumeType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" use="required"/>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- ===== Profile (Sammlung von Effekten) ===== -->
    <xs:complexType name="ProfileType">
        <xs:sequence>
            <xs:element name="tonemap" type="postfx:TonemapType" minOccurs="0"/>
            <xs:element name="colorGrading" type="postfx:ColorGradingType" minOccurs="0"/>
            <xs:element name="bloom" type="postfx:BloomType" minOccurs="0"/>
            <xs:element name="ssao" type="postfx:SSAOType" minOccurs="0"/>
            <xs:element name="ssr" type="postfx:SSRType" minOccurs="0"/>
            <xs:element name="dof" type="postfx:DOFType" minOccurs="0"/>
            <xs:element name="motionBlur" type="postfx:MotionBlurType" minOccurs="0"/>
            <xs:element name="vignette" type="postfx:VignetteType" minOccurs="0"/>
            <xs:element name="chromaticAberration" type="postfx:ChromaticAberrationType" minOccurs="0"/>
            <xs:element name="filmGrain" type="postfx:FilmGrainType" minOccurs="0"/>
            <xs:element name="lensDistortion" type="postfx:LensDistortionType" minOccurs="0"/>
            <xs:element name="antialiasing" type="postfx:AntialiasingType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- ===== Volume (räumlicher Blender zwischen Profilen) ===== -->
    <xs:complexType name="VolumeType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="profileRef" type="xs:string" use="required"/>
        <xs:attribute name="global" type="xs:boolean" default="false"/>
        <xs:attribute name="priority" type="xs:int" default="0"/>
        <xs:attribute name="weight" type="xs:float" default="1.0"/>
        <xs:attribute name="blendDistance" type="xs:float" default="0.0"/>
        <xs:attribute name="entity" type="xs:string"/>
    </xs:complexType>

    <!-- ===== Tonemapping ===== -->
    <xs:complexType name="TonemapType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="mode" type="postfx:TonemapModeEnum" default="aces"/>
        <xs:attribute name="exposure" type="xs:float" default="1.0"/>
    </xs:complexType>

    <xs:simpleType name="TonemapModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="linear"/>
            <xs:enumeration value="reinhard"/>
            <xs:enumeration value="aces"/>
            <xs:enumeration value="filmic"/>
            <xs:enumeration value="uncharted2"/>
            <xs:enumeration value="agx"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Color-Grading ===== -->
    <xs:complexType name="ColorGradingType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="temperature" type="xs:float" default="0.0"/>
        <xs:attribute name="tint" type="xs:float" default="0.0"/>
        <xs:attribute name="saturation" type="xs:float" default="0.0"/>
        <xs:attribute name="contrast" type="xs:float" default="0.0"/>
        <xs:attribute name="brightness" type="xs:float" default="0.0"/>
        <xs:attribute name="gamma" type="xs:float" default="1.0"/>
        <xs:attribute name="lut" type="xs:string"/>
        <xs:attribute name="lutIntensity" type="xs:float" default="1.0"/>
    </xs:complexType>

    <!-- ===== Bloom ===== -->
    <xs:complexType name="BloomType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="threshold" type="xs:float" default="1.0"/>
        <xs:attribute name="intensity" type="xs:float" default="0.5"/>
        <xs:attribute name="scatter" type="xs:float" default="0.7"/>
        <xs:attribute name="dirtTexture" type="xs:string"/>
        <xs:attribute name="dirtIntensity" type="xs:float" default="0.0"/>
    </xs:complexType>

    <!-- ===== SSAO / SSR ===== -->
    <xs:complexType name="SSAOType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="intensity" type="xs:float" default="0.5"/>
        <xs:attribute name="radius" type="xs:float" default="0.5"/>
        <xs:attribute name="samples" type="xs:int" default="16"/>
        <xs:attribute name="quality" type="postfx:QualityEnum" default="medium"/>
    </xs:complexType>

    <xs:complexType name="SSRType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="maxRoughness" type="xs:float" default="0.5"/>
        <xs:attribute name="stepCount" type="xs:int" default="32"/>
        <xs:attribute name="thickness" type="xs:float" default="0.1"/>
        <xs:attribute name="quality" type="postfx:QualityEnum" default="medium"/>
    </xs:complexType>

    <xs:simpleType name="QualityEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="low"/>
            <xs:enumeration value="medium"/>
            <xs:enumeration value="high"/>
            <xs:enumeration value="ultra"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Depth-of-Field / Motion-Blur ===== -->
    <xs:complexType name="DOFType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="mode" type="postfx:DOFModeEnum" default="bokeh"/>
        <xs:attribute name="focusDistance" type="xs:float" default="5.0"/>
        <xs:attribute name="aperture" type="xs:float" default="2.8"/>
        <xs:attribute name="focalLengthMm" type="xs:float" default="50.0"/>
        <xs:attribute name="bokehShape" type="postfx:BokehShapeEnum" default="hexagon"/>
    </xs:complexType>

    <xs:simpleType name="DOFModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="gaussian"/>
            <xs:enumeration value="bokeh"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="BokehShapeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="circle"/>
            <xs:enumeration value="hexagon"/>
            <xs:enumeration value="octagon"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="MotionBlurType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="shutterAngle" type="xs:float" default="180.0"/>
        <xs:attribute name="sampleCount" type="xs:int" default="8"/>
    </xs:complexType>

    <!-- ===== Vignette / CA / Grain / Distortion ===== -->
    <xs:complexType name="VignetteType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="color" type="xs:string" default="#000000"/>
        <xs:attribute name="intensity" type="xs:float" default="0.3"/>
        <xs:attribute name="smoothness" type="xs:float" default="0.5"/>
        <xs:attribute name="rounded" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:complexType name="ChromaticAberrationType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="intensity" type="xs:float" default="0.2"/>
    </xs:complexType>

    <xs:complexType name="FilmGrainType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="intensity" type="xs:float" default="0.2"/>
        <xs:attribute name="size" type="xs:float" default="1.0"/>
    </xs:complexType>

    <xs:complexType name="LensDistortionType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="intensity" type="xs:float" default="0.0"/>
        <xs:attribute name="xMultiplier" type="xs:float" default="1.0"/>
        <xs:attribute name="yMultiplier" type="xs:float" default="1.0"/>
    </xs:complexType>

    <!-- ===== Antialiasing ===== -->
    <xs:complexType name="AntialiasingType">
        <xs:attribute name="mode" type="postfx:AntialiasingModeEnum" default="taa"/>
        <xs:attribute name="quality" type="postfx:QualityEnum" default="high"/>
    </xs:complexType>

    <xs:simpleType name="AntialiasingModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="none"/>
            <xs:enumeration value="fxaa"/>
            <xs:enumeration value="smaa"/>
            <xs:enumeration value="taa"/>
            <xs:enumeration value="msaa2x"/>
            <xs:enumeration value="msaa4x"/>
            <xs:enumeration value="msaa8x"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
