<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:cam="https://chevp.github.io/synth-protocol/schema/synth/camera/1.0"
           xmlns:common="https://chevp.github.io/synth-protocol/schema/synth/common-types"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/camera/1.0"
           elementFormDefault="qualified">

    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/common-types"
               schemaLocation="../../common-types.xsd"/>

    <!-- =========================================================================
         SYNTH CAMERA SCHEMA
         Cinematic Cameras: virtuelle Kameras mit Prioritäten (Cinemachine-Stil),
         Splines, Cuts, Triggered-Changes, Multi-Viewport.
         Erweitert scene.xsd CameraType (das nur ein Mode hat).
         Root element: <synthCameras>
         ========================================================================= -->

    <xs:element name="synth-cameras" type="cam:SynthCamerasType"/>

    <xs:complexType name="SynthCamerasType">
        <xs:sequence>
            <xs:element name="virtual-camera" type="cam:VirtualCameraType" maxOccurs="unbounded"/>
            <xs:element name="brain" type="cam:BrainType" minOccurs="0"/>
            <xs:element name="splines" type="cam:SplinesType" minOccurs="0"/>
            <xs:element name="viewports" type="cam:ViewportsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" use="required"/>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Virtuelle Kamera: ein konkreter Blick auf die Welt -->
    <xs:complexType name="VirtualCameraType">
        <xs:sequence>
            <xs:element name="lens" type="cam:LensType"/>
            <xs:element name="position" type="common:Vec3Type" minOccurs="0"/>
            <xs:element name="rotation" type="common:Vec3Type" minOccurs="0"/>
            <xs:element name="follow" type="cam:FollowType" minOccurs="0"/>
            <xs:element name="look-at" type="cam:LookAtType" minOccurs="0"/>
            <xs:element name="path" type="cam:PathRefType" minOccurs="0"/>
            <xs:element name="noise" type="cam:NoiseType" minOccurs="0"/>
            <xs:element name="composer" type="cam:ComposerType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="priority" type="xs:int" default="10"/>
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
    </xs:complexType>

    <xs:complexType name="LensType">
        <xs:attribute name="mode" type="cam:LensModeEnum" default="perspective"/>
        <xs:attribute name="fov" type="xs:float" default="60"/>
        <xs:attribute name="ortho-size" type="xs:float"/>
        <xs:attribute name="near" type="xs:float" default="0.1"/>
        <xs:attribute name="far" type="xs:float" default="1000"/>
        <xs:attribute name="dutch" type="xs:float" default="0"/>
    </xs:complexType>

    <xs:simpleType name="LensModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="perspective"/>
            <xs:enumeration value="orthographic"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="FollowType">
        <xs:sequence>
            <xs:element name="offset" type="common:Vec3Type" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="target" type="xs:string" use="required"/>
        <xs:attribute name="damping" type="xs:float" default="0.3"/>
        <xs:attribute name="mode" type="cam:FollowModeEnum" default="thirdPerson"/>
    </xs:complexType>

    <xs:simpleType name="FollowModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="firstPerson"/>
            <xs:enumeration value="thirdPerson"/>
            <xs:enumeration value="topDown"/>
            <xs:enumeration value="sideScroll"/>
            <xs:enumeration value="orbit"/>
            <xs:enumeration value="static"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="LookAtType">
        <xs:attribute name="target" type="xs:string" use="required"/>
        <xs:attribute name="damping" type="xs:float" default="0.2"/>
    </xs:complexType>

    <xs:complexType name="PathRefType">
        <xs:attribute name="spline-ref" type="xs:string" use="required"/>
        <xs:attribute name="speed" type="xs:float" default="1.0"/>
        <xs:attribute name="loop" type="xs:boolean" default="false"/>
    </xs:complexType>

    <!-- Noise: Handheld-Look, Earthquake-Shake, Idle-Sway -->
    <xs:complexType name="NoiseType">
        <xs:attribute name="profile" type="cam:NoiseProfileEnum" default="handheld"/>
        <xs:attribute name="amplitude" type="xs:float" default="1.0"/>
        <xs:attribute name="frequency" type="xs:float" default="1.0"/>
    </xs:complexType>

    <xs:simpleType name="NoiseProfileEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="none"/>
            <xs:enumeration value="handheld"/>
            <xs:enumeration value="shake"/>
            <xs:enumeration value="idleSway"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="ComposerType">
        <xs:attribute name="screen-x" type="xs:float" default="0.5"/>
        <xs:attribute name="screen-y" type="xs:float" default="0.5"/>
        <xs:attribute name="dead-zone-width" type="xs:float" default="0.1"/>
        <xs:attribute name="dead-zone-height" type="xs:float" default="0.1"/>
        <xs:attribute name="soft-zone-width" type="xs:float" default="0.3"/>
        <xs:attribute name="soft-zone-height" type="xs:float" default="0.3"/>
    </xs:complexType>

    <!-- Brain: wählt aktive Kamera, mischt Übergänge -->
    <xs:complexType name="BrainType">
        <xs:attribute name="default-blend" type="cam:BlendStyleEnum" default="easeInOut"/>
        <xs:attribute name="default-blend-time" type="xs:float" default="2.0"/>
        <xs:attribute name="update-mode" type="cam:UpdateModeEnum" default="lateUpdate"/>
    </xs:complexType>

    <xs:simpleType name="BlendStyleEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="cut"/>
            <xs:enumeration value="linear"/>
            <xs:enumeration value="easeInOut"/>
            <xs:enumeration value="easeIn"/>
            <xs:enumeration value="easeOut"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="UpdateModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="update"/>
            <xs:enumeration value="lateUpdate"/>
            <xs:enumeration value="fixedUpdate"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Splines (für Path-Cameras) ===== -->
    <xs:complexType name="SplinesType">
        <xs:sequence>
            <xs:element name="spline" type="cam:SplineType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SplineType">
        <xs:sequence>
            <xs:element name="point" type="cam:SplinePointType" minOccurs="2" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="type" type="cam:SplineTypeEnum" default="catmullRom"/>
        <xs:attribute name="closed" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:simpleType name="SplineTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="linear"/>
            <xs:enumeration value="catmullRom"/>
            <xs:enumeration value="bezier"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="SplinePointType">
        <xs:sequence>
            <xs:element name="position" type="common:Vec3Type"/>
            <xs:element name="tangent-in" type="common:Vec3Type" minOccurs="0"/>
            <xs:element name="tangent-out" type="common:Vec3Type" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="t" type="xs:float"/>
    </xs:complexType>

    <!-- ===== Viewports (Multi-Camera, Split-Screen) ===== -->
    <xs:complexType name="ViewportsType">
        <xs:sequence>
            <xs:element name="viewport" type="cam:ViewportType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ViewportType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="camera-ref" type="xs:string" use="required"/>
        <xs:attribute name="x" type="xs:float" default="0"/>
        <xs:attribute name="y" type="xs:float" default="0"/>
        <xs:attribute name="width" type="xs:float" default="1"/>
        <xs:attribute name="height" type="xs:float" default="1"/>
        <xs:attribute name="render-order" type="xs:int" default="0"/>
    </xs:complexType>

</xs:schema>
