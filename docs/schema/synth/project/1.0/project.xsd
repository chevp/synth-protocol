<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:project="https://chevp.github.io/synth-protocol/schema/synth/project/1.0"
           xmlns:common="https://chevp.github.io/synth-protocol/schema/synth/common-types"
           xmlns:core="https://chevp.github.io/synth-protocol/schema/synth/core/1.0"
           xmlns:mcp="https://chevp.github.io/synth-protocol/schema/synth/mcp/1.0"
           xmlns:security="https://chevp.github.io/synth-protocol/schema/synth/security/1.0"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/project/1.0"
           elementFormDefault="qualified">

    <!-- Imports -->
    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/common-types"
               schemaLocation="../../common-types.xsd"/>
    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/core/1.0" schemaLocation="../core/1.0/core.xsd"/>
    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/mcp/1.0" schemaLocation="../mcp/1.0/mcp.xsd"/>
    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/security/1.0" schemaLocation="../security/1.0/security.xsd"/>
    <!-- =========================================================================
         SYNTH PROJECT SCHEMA
         Root element for Synth project configuration files (.synth)
         ========================================================================= -->

    <!-- Root Element -->
    <xs:element name="synthProject" type="project:SynthProjectType"/>

    <!-- Project Type Definition -->
    <xs:complexType name="SynthProjectType">
        <xs:sequence>
            <!-- Project Metadata -->
            <xs:element name="metadata" type="project:ProjectMetadataType"/>

            <!-- Core Configuration -->
            <xs:element ref="core:configuration" minOccurs="0"/>

            <!-- MCP Server Configuration -->
            <xs:element ref="mcp:servers" minOccurs="0"/>

            <!-- Security Configuration -->
            <xs:element ref="security:security" minOccurs="0"/>

            <!-- Tool Registry (CLI tools used by pipelines) -->
            <xs:element name="toolRegistry" type="project:ToolRegistryType" minOccurs="0"/>

            <!-- Pipeline Definitions -->
            <xs:element name="pipelines" type="project:PipelinesType" minOccurs="0"/>

            <!-- Asset Mounts (VFS mount-points for asset resolution) -->
            <xs:element name="mounts" type="project:MountsType" minOccurs="0"/>

            <!-- Resource References -->
            <xs:element name="resources" type="project:ResourcesType" minOccurs="0"/>

            <!-- Settings (key-value pairs) -->
            <xs:element name="settings" type="project:ProjectSettingsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" default="1.0"/>
        <xs:attribute name="schemaVersion" type="xs:string" default="1.0"/>
    </xs:complexType>

    <!-- Project Metadata -->
    <xs:complexType name="ProjectMetadataType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="version" type="xs:string"/>
            <xs:element name="author" type="xs:string" minOccurs="0"/>
            <xs:element name="created" type="xs:dateTime" minOccurs="0"/>
            <xs:element name="modified" type="xs:dateTime" minOccurs="0"/>
            <xs:element name="tags" type="project:TagsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="TagsType">
        <xs:sequence>
            <xs:element name="tag" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- =========================================================================
         TOOL REGISTRY
         Declares external CLI tools used by pipeline steps.
         The executor (synth-core) resolves tool paths at runtime.
         ========================================================================= -->

    <xs:complexType name="ToolRegistryType">
        <xs:sequence>
            <xs:element name="tool" type="project:ToolDefType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ToolDefType">
        <xs:sequence>
            <xs:element name="config" type="project:ProjectConfigMapType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="executable" type="xs:string" use="required"/>
        <xs:attribute name="version" type="xs:string"/>
    </xs:complexType>

    <!-- =========================================================================
         PIPELINES CONFIGURATION
         Declarative task chains executed by synth-core (C++).
         Steps reference tools from the registry and define I/O.
         ========================================================================= -->

    <xs:complexType name="PipelinesType">
        <xs:sequence>
            <xs:element name="pipeline" type="project:PipelineType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PipelineType">
        <xs:sequence>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="steps" type="project:StepsType"/>
            <xs:element name="triggers" type="project:TriggersType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
    </xs:complexType>

    <xs:complexType name="StepsType">
        <xs:sequence>
            <xs:element name="step" type="project:StepType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StepType">
        <xs:sequence>
            <xs:element name="input" type="project:IOType" minOccurs="0"/>
            <xs:element name="output" type="project:IOType" minOccurs="0"/>
            <xs:element name="config" type="project:ProjectConfigMapType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="tool" type="xs:string" use="required"/>
        <xs:attribute name="dependsOn" type="xs:string"/>
        <xs:attribute name="timeout" type="xs:int"/>
        <xs:attribute name="continueOnError" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:complexType name="IOType">
        <xs:sequence>
            <xs:element name="param" type="project:ParamType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ParamType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="name" type="xs:string" use="required"/>
                <xs:attribute name="type" type="xs:string"/>
                <xs:attribute name="ref" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="TriggersType">
        <xs:sequence>
            <xs:element name="trigger" type="project:TriggerType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="TriggerType">
        <xs:attribute name="type" type="project:TriggerTypeEnum" use="required"/>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="pattern" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="TriggerTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="manual"/>
            <xs:enumeration value="schedule"/>
            <xs:enumeration value="file-watch"/>
            <xs:enumeration value="event"/>
            <xs:enumeration value="hub-event"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- =========================================================================
         PROJECT CONFIG MAP
         Local config map type to avoid cross-namespace issues with entry elements.
         ========================================================================= -->

    <xs:complexType name="ProjectConfigMapType">
        <xs:sequence>
            <xs:element name="entry" type="project:ProjectConfigEntryType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ProjectConfigEntryType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="key" type="xs:string" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Project Settings (local type to avoid cross-namespace issues) -->
    <xs:complexType name="ProjectSettingsType">
        <xs:sequence>
            <xs:element name="setting" type="project:ProjectSettingType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ProjectSettingType">
        <xs:attribute name="key" type="xs:string" use="required"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- =========================================================================
         ASSET MOUNTS
         VFS mount-points mapping URI schemes to physical directories.
         nuna-runtime resolves asset://path and asset-src://path at runtime.
         ========================================================================= -->

    <xs:complexType name="MountsType">
        <xs:sequence>
            <xs:element name="mount" type="project:MountType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MountType">
        <xs:attribute name="scheme" type="xs:string" use="required"/>
        <xs:attribute name="path" type="xs:string" use="required"/>
        <xs:attribute name="readOnly" type="xs:boolean" default="true"/>
    </xs:complexType>

    <!-- Resources Configuration -->
    <xs:complexType name="ResourcesType">
        <xs:sequence>
            <xs:element name="resource" type="project:ResourceType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ResourceType">
        <xs:sequence>
            <xs:element name="metadata" type="project:ProjectConfigMapType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="type" type="project:ResourceTypeEnum" use="required"/>
        <xs:attribute name="uri" type="xs:anyURI" use="required"/>
    </xs:complexType>

    <xs:simpleType name="ResourceTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="model"/>
            <xs:enumeration value="dataset"/>
            <xs:enumeration value="config"/>
            <xs:enumeration value="asset"/>
            <xs:enumeration value="script"/>
            <xs:enumeration value="blend"/>
            <xs:enumeration value="texture"/>
            <xs:enumeration value="shader"/>
            <xs:enumeration value="audio"/>
            <xs:enumeration value="scene"/>
            <xs:enumeration value="directory"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
