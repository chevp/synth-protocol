<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:game="https://chevp.github.io/synth-protocol/schema/synth/project/1.0/game"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/project/1.0/game"
           elementFormDefault="qualified">

    <!-- =========================================================================
         CRYO GAME PROJECT SCHEMA (.cryo files)

         Purpose: Game project descriptor that launches both backend and renderer

         Use Case: Developer double-clicks .cryo file to start entire project

         CRITICAL DISTINCTION:
         - .cryo   → Launches BOTH backend (.synth) AND renderer (.frost)
         - .frost  → Launches ONLY renderer (for game players)
         - .synth  → Launches ONLY backend (for servers)

         This file orchestrates the complete development environment.
         ========================================================================= -->

    <!-- Root Element -->
    <xs:element name="synthGameProject" type="game:SynthGameProjectType"/>

    <!-- Game Project Configuration -->
    <xs:complexType name="SynthGameProjectType">
        <xs:sequence>
            <!-- Project Metadata -->
            <xs:element name="metadata" type="game:MetadataType"/>

            <!-- Backend Runtime Configuration -->
            <xs:element name="backend" type="game:BackendType"/>

            <!-- Renderer Runtime Configuration -->
            <xs:element name="renderer" type="game:RendererType"/>

            <!-- Project Paths (relative to .synth-game file) -->
            <xs:element name="paths" type="game:PathsType" minOccurs="0"/>

            <!-- Launcher Configuration -->
            <xs:element name="launcher" type="game:LauncherType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Metadata -->
    <xs:complexType name="MetadataType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="version" type="xs:string" minOccurs="0"/>
            <xs:element name="author" type="xs:string" minOccurs="0"/>
            <xs:element name="created" type="xs:dateTime" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Backend Configuration -->
    <xs:complexType name="BackendType">
        <xs:sequence>
            <!-- Path to .synth runtime file (relative to .synth-game file) -->
            <xs:element name="runtime" type="xs:string"/>

            <!-- Auto-start backend when project opens -->
            <xs:element name="autoStart" type="xs:boolean" default="true" minOccurs="0"/>

            <!-- Wait for backend to be ready before starting renderer -->
            <xs:element name="waitForReady" type="xs:boolean" default="true" minOccurs="0"/>

            <!-- Startup timeout in seconds -->
            <xs:element name="startupTimeout" type="xs:int" default="30" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Renderer Configuration -->
    <xs:complexType name="RendererType">
        <xs:sequence>
            <!-- Path to .frost runtime file (relative to .synth-game file) -->
            <xs:element name="runtime" type="xs:string"/>

            <!-- Auto-start renderer when project opens -->
            <xs:element name="autoStart" type="xs:boolean" default="true" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Project Paths -->
    <xs:complexType name="PathsType">
        <xs:sequence>
            <xs:element name="assets" type="xs:string" minOccurs="0"/>
            <xs:element name="scenes" type="xs:string" minOccurs="0"/>
            <xs:element name="components" type="xs:string" minOccurs="0"/>
            <xs:element name="scripts" type="xs:string" minOccurs="0"/>
            <xs:element name="data" type="xs:string" minOccurs="0"/>
            <xs:element name="config" type="xs:string" minOccurs="0"/>
            <xs:element name="mounts" type="game:MountsType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Asset Mounts (VFS mount-points for asset resolution) -->
    <xs:complexType name="MountsType">
        <xs:sequence>
            <xs:element name="mount" type="game:MountType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MountType">
        <xs:attribute name="scheme" type="xs:string" use="required"/>
        <xs:attribute name="path" type="xs:string" use="required"/>
        <xs:attribute name="readOnly" type="xs:boolean" default="true"/>
    </xs:complexType>

    <!-- Launcher Configuration -->
    <xs:complexType name="LauncherType">
        <xs:sequence>
            <!-- Startup order: sequential or parallel -->
            <xs:element name="startupOrder" type="game:StartupOrderEnum" default="sequential" minOccurs="0"/>

            <!-- Show console windows (for debugging) -->
            <xs:element name="showConsole" type="xs:boolean" default="true" minOccurs="0"/>

            <!-- Working directory (relative to .synth-game file) -->
            <xs:element name="workingDirectory" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="StartupOrderEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="sequential"/>  <!-- Backend first, then renderer -->
            <xs:enumeration value="parallel"/>    <!-- Both at once -->
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
