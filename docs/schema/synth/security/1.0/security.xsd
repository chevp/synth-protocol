<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:security="https://chevp.github.io/synth-protocol/schema/synth/security/1.0"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/security/1.0"
           elementFormDefault="qualified">

    <!-- =========================================================================
         SYNTH SECURITY SCHEMA
         Security and access control configuration
         ========================================================================= -->

    <!-- Security Root Element -->
    <xs:element name="security" type="security:SecurityType"/>

    <!-- Security Configuration -->
    <xs:complexType name="SecurityType">
        <xs:sequence>
            <!-- Authentication -->
            <xs:element name="authentication" type="security:AuthenticationType" minOccurs="0"/>

            <!-- Authorization -->
            <xs:element name="authorization" type="security:AuthorizationType" minOccurs="0"/>

            <!-- Encryption -->
            <xs:element name="encryption" type="security:EncryptionType" minOccurs="0"/>

            <!-- Audit -->
            <xs:element name="audit" type="security:AuditType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
    </xs:complexType>

    <!-- Authentication Configuration -->
    <xs:complexType name="AuthenticationType">
        <xs:sequence>
            <xs:element name="provider" type="security:AuthProviderType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="required" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:complexType name="AuthProviderType">
        <xs:sequence>
            <xs:element name="config" type="security:ConfigMapType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="type" type="security:AuthProviderTypeEnum" use="required"/>
        <xs:attribute name="id" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="AuthProviderTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="api-key"/>
            <xs:enumeration value="jwt"/>
            <xs:enumeration value="oauth2"/>
            <xs:enumeration value="mtls"/>
            <xs:enumeration value="basic"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Authorization Configuration -->
    <xs:complexType name="AuthorizationType">
        <xs:sequence>
            <xs:element name="policies" type="security:PoliciesType" minOccurs="0"/>
            <xs:element name="roles" type="security:RolesType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="model" type="security:AuthModelEnum" default="rbac"/>
    </xs:complexType>

    <xs:simpleType name="AuthModelEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="rbac"/>
            <xs:enumeration value="abac"/>
            <xs:enumeration value="acl"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="PoliciesType">
        <xs:sequence>
            <xs:element name="policy" type="security:PolicyType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PolicyType">
        <xs:sequence>
            <xs:element name="resources" type="security:ResourcePatternsType"/>
            <xs:element name="actions" type="security:ActionsType"/>
            <xs:element name="conditions" type="security:ConditionsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="effect" type="security:EffectEnum" default="allow"/>
    </xs:complexType>

    <xs:simpleType name="EffectEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="allow"/>
            <xs:enumeration value="deny"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="ResourcePatternsType">
        <xs:sequence>
            <xs:element name="resource" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ActionsType">
        <xs:sequence>
            <xs:element name="action" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ConditionsType">
        <xs:sequence>
            <xs:element name="condition" type="security:ConditionType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ConditionType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="key" type="xs:string" use="required"/>
                <xs:attribute name="operator" type="security:OperatorEnum" default="equals"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:simpleType name="OperatorEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="equals"/>
            <xs:enumeration value="not-equals"/>
            <xs:enumeration value="contains"/>
            <xs:enumeration value="starts-with"/>
            <xs:enumeration value="matches"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="RolesType">
        <xs:sequence>
            <xs:element name="role" type="security:RoleType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RoleType">
        <xs:sequence>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="permissions" type="security:PermissionsType"/>
            <xs:element name="inherits" type="security:InheritsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="name" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="PermissionsType">
        <xs:sequence>
            <xs:element name="permission" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="InheritsType">
        <xs:sequence>
            <xs:element name="role" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Encryption Configuration -->
    <xs:complexType name="EncryptionType">
        <xs:sequence>
            <xs:element name="at-rest" type="security:EncryptionConfigType" minOccurs="0"/>
            <xs:element name="in-transit" type="security:TransitEncryptionType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="EncryptionConfigType">
        <xs:sequence>
            <xs:element name="key-provider" type="xs:string" minOccurs="0"/>
            <xs:element name="config" type="security:ConfigMapType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="algorithm" type="xs:string" default="AES-256-GCM"/>
    </xs:complexType>

    <xs:complexType name="TransitEncryptionType">
        <xs:sequence>
            <xs:element name="certificate" type="xs:string" minOccurs="0"/>
            <xs:element name="private-key" type="xs:string" minOccurs="0"/>
            <xs:element name="ca" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="min-version" type="xs:string" default="TLS1.2"/>
    </xs:complexType>

    <!-- Audit Configuration -->
    <xs:complexType name="AuditType">
        <xs:sequence>
            <xs:element name="events" type="security:AuditEventsType" minOccurs="0"/>
            <xs:element name="destination" type="security:AuditDestinationType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
    </xs:complexType>

    <xs:complexType name="AuditEventsType">
        <xs:sequence>
            <xs:element name="event" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="log-all" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:complexType name="AuditDestinationType">
        <xs:sequence>
            <xs:element name="config" type="security:ConfigMapType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="type" type="security:AuditDestTypeEnum" use="required"/>
    </xs:complexType>

    <xs:simpleType name="AuditDestTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="file"/>
            <xs:enumeration value="syslog"/>
            <xs:enumeration value="database"/>
            <xs:enumeration value="webhook"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Generic Config Map -->
    <xs:complexType name="ConfigMapType">
        <xs:sequence>
            <xs:element name="entry" type="security:ConfigEntryType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ConfigEntryType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="key" type="xs:string" use="required"/>
                <xs:attribute name="secret" type="xs:boolean" default="false"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

</xs:schema>