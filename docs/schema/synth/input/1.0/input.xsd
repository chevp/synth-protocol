<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:input="https://chevp.github.io/synth-protocol/schema/synth/input/1.0"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/input/1.0"
           elementFormDefault="qualified">

    <!-- =========================================================================
         SYNTH INPUT SCHEMA
         Action-Maps für Keyboard/Mouse/Gamepad/Touch.
         Binding-Contexts (Gameplay, Menu, Dialog, Vehicle, ...).
         Root element: <synthInput>
         ========================================================================= -->

    <xs:element name="synth-input" type="input:SynthInputType"/>

    <xs:complexType name="SynthInputType">
        <xs:sequence>
            <xs:element name="contexts" type="input:ContextsType"/>
            <xs:element name="action-maps" type="input:ActionMapsType"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" use="required"/>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Contexts: nur ein Context ist gleichzeitig aktiv (Stack-Modell) -->
    <xs:complexType name="ContextsType">
        <xs:sequence>
            <xs:element name="context" type="input:ContextType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ContextType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="priority" type="xs:int" default="0"/>
        <xs:attribute name="blocks-lower" type="xs:boolean" default="true"/>
    </xs:complexType>

    <!-- Action-Maps: gruppieren Actions pro Context -->
    <xs:complexType name="ActionMapsType">
        <xs:sequence>
            <xs:element name="action-map" type="input:ActionMapType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ActionMapType">
        <xs:sequence>
            <xs:element name="action" type="input:ActionType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="context" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Action: ein logisches Ereignis mit beliebigen Bindings -->
    <xs:complexType name="ActionType">
        <xs:sequence>
            <xs:element name="binding" type="input:BindingType" maxOccurs="unbounded"/>
            <xs:element name="modifier" type="input:ModifierType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="type" type="input:ActionTypeEnum" use="required"/>
        <xs:attribute name="description" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="ActionTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="button"/>     <!-- discrete press/release -->
            <xs:enumeration value="axis1d"/>     <!-- single float (-1..1 or 0..1) -->
            <xs:enumeration value="axis2d"/>     <!-- vec2 (stick, mouse-delta) -->
            <xs:enumeration value="axis3d"/>     <!-- vec3 (motion controllers) -->
            <xs:enumeration value="value"/>      <!-- raw value (trigger 0..1) -->
        </xs:restriction>
    </xs:simpleType>

    <!-- Binding: konkrete Geräte-Quelle -->
    <xs:complexType name="BindingType">
        <xs:attribute name="device" type="input:DeviceEnum" use="required"/>
        <!-- key/button/axis identifier (device-specific, e.g. "W", "Space",
             "MouseLeft", "GamepadA", "LeftStickX", "LeftTrigger") -->
        <xs:attribute name="path" type="xs:string" use="required"/>
        <!-- Optional inversion / scale -->
        <xs:attribute name="scale" type="xs:float" default="1.0"/>
        <xs:attribute name="invert" type="xs:boolean" default="false"/>
        <!-- Composite-Bindings: WASD -> axis2d via "north","south","east","west" -->
        <xs:attribute name="composite" type="input:CompositePartEnum"/>
    </xs:complexType>

    <xs:simpleType name="DeviceEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="keyboard"/>
            <xs:enumeration value="mouse"/>
            <xs:enumeration value="gamepad"/>
            <xs:enumeration value="touch"/>
            <xs:enumeration value="pen"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CompositePartEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="north"/>
            <xs:enumeration value="south"/>
            <xs:enumeration value="east"/>
            <xs:enumeration value="west"/>
            <xs:enumeration value="up"/>
            <xs:enumeration value="down"/>
            <xs:enumeration value="positive"/>
            <xs:enumeration value="negative"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Modifier: Verarbeitung roher Eingabe -->
    <xs:complexType name="ModifierType">
        <xs:attribute name="type" type="input:ModifierTypeEnum" use="required"/>
        <xs:attribute name="value" type="xs:float"/>
    </xs:complexType>

    <xs:simpleType name="ModifierTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="deadzone"/>
            <xs:enumeration value="sensitivity"/>
            <xs:enumeration value="smooth"/>
            <xs:enumeration value="hold"/>
            <xs:enumeration value="tap"/>
            <xs:enumeration value="doubleTap"/>
            <xs:enumeration value="invertY"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
