<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ar="https://chevp.github.io/synth-protocol/schema/synth/asset-registry/1.0"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/asset-registry/1.0"
           elementFormDefault="qualified">

    <!-- =========================================================================
         SYNTH ASSET REGISTRY SCHEMA
         Describes a remotely-hosted asset package registry.
         Similar to npm registry but for 3D assets, textures, scenes, components.
         Assets are accessible via HTTPS URI from the registry's baseUrl.
         ========================================================================= -->

    <!-- Root Element -->
    <xs:element name="synthAssetRegistry" type="ar:AssetRegistryType"/>

    <xs:complexType name="AssetRegistryType">
        <xs:sequence>
            <xs:element name="manifest" type="ar:ManifestType"/>
            <xs:element name="packages" type="ar:PackagesType"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" default="1.0"/>
    </xs:complexType>

    <!-- =========================================================================
         MANIFEST
         Registry identification and base URL for asset resolution.
         Full asset URL = baseUrl + "/" + package asset uri
         ========================================================================= -->

    <xs:complexType name="ManifestType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="version" type="xs:string"/>
            <xs:element name="author" type="xs:string" minOccurs="0"/>
            <xs:element name="baseUrl" type="xs:anyURI"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- =========================================================================
         PACKAGES
         Versioned collections of assets with optional dependencies.
         ========================================================================= -->

    <xs:complexType name="PackagesType">
        <xs:sequence>
            <xs:element name="package" type="ar:PackageType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PackageType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="tags" type="ar:TagsType" minOccurs="0"/>
            <xs:element name="assets" type="ar:AssetsType"/>
            <xs:element name="dependencies" type="ar:DependenciesType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="TagsType">
        <xs:sequence>
            <xs:element name="tag" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- =========================================================================
         ASSETS
         Individual assets within a package.
         URI is relative to the registry's baseUrl.
         ========================================================================= -->

    <xs:complexType name="AssetsType">
        <xs:sequence>
            <xs:element name="asset" type="ar:AssetType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AssetType">
        <xs:attribute name="type" type="ar:AssetTypeEnum" use="required"/>
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="uri" type="xs:string" use="required"/>
        <xs:attribute name="size" type="xs:long" use="optional"/>
    </xs:complexType>

    <xs:simpleType name="AssetTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="model"/>
            <xs:enumeration value="texture"/>
            <xs:enumeration value="scene"/>
            <xs:enumeration value="component"/>
            <xs:enumeration value="shader"/>
            <xs:enumeration value="audio"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- =========================================================================
         DEPENDENCIES
         Package-level dependencies on other packages in the same registry.
         ========================================================================= -->

    <xs:complexType name="DependenciesType">
        <xs:sequence>
            <xs:element name="dependency" type="ar:DependencyType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="DependencyType">
        <xs:attribute name="package" type="xs:string" use="required"/>
        <xs:attribute name="minVersion" type="xs:string" use="optional"/>
    </xs:complexType>

</xs:schema>
