<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:events="https://chevp.github.io/synth-protocol/schema/synth/events/1.0"
           xmlns:core="https://chevp.github.io/synth-protocol/schema/synth/core/1.0"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/events/1.0"
           elementFormDefault="qualified">

    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/core/1.0"
               schemaLocation="../../core/1.0/core.xsd"/>

    <!-- =========================================================================
         SYNTH EVENTS SCHEMA
         Event-based message passing with URI syntax for routing and filtering
         ========================================================================= -->

    <!-- =========================================================================
         ROOT ELEMENTS
         ========================================================================= -->

    <!-- Single Event -->
    <xs:element name="event" type="events:EventType"/>

    <!-- Event Batch -->
    <xs:element name="eventBatch" type="events:EventBatchType"/>

    <!-- Subscription -->
    <xs:element name="subscription" type="events:SubscriptionType"/>

    <!-- Event Stream (for examples/documentation) -->
    <xs:element name="eventStream" type="events:EventStreamType"/>

    <!-- =========================================================================
         EVENT URI
         Structured URI for event routing: scheme://path/action#subject?query
         Example: synth://cluster/node/created#node-uuid-123?parent=scene-main
         ========================================================================= -->

    <xs:complexType name="EventUriType">
        <xs:sequence>
            <!-- Query parameters as key-value pairs -->
            <xs:element name="query" type="events:QueryParamsType" minOccurs="0"/>
        </xs:sequence>
        <!-- URI scheme: synth, nuna, mcp, plugin -->
        <xs:attribute name="scheme" type="events:UriSchemeEnum" use="required"/>
        <!-- Hierarchical path: cluster/node, mcp/server -->
        <xs:attribute name="path" type="xs:string" use="required"/>
        <!-- Action/event type: created, updated, deleted -->
        <xs:attribute name="action" type="xs:string" use="required"/>
        <!-- Subject identifier (URI fragment) -->
        <xs:attribute name="subject" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="UriSchemeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="synth"/>
            <xs:enumeration value="nuna"/>
            <xs:enumeration value="mcp"/>
            <xs:enumeration value="plugin"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="QueryParamsType">
        <xs:sequence>
            <xs:element name="param" type="events:QueryParamType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="QueryParamType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="key" type="xs:string" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- =========================================================================
         EVENT ENVELOPE
         Complete event message with metadata and payload
         ========================================================================= -->

    <xs:complexType name="EventType">
        <xs:sequence>
            <!-- Event URI for routing -->
            <xs:element name="uri" type="events:EventUriType"/>
            <!-- Event metadata -->
            <xs:element name="metadata" type="events:EventMetadataType"/>
            <!-- Event payload (choice of typed payloads) -->
            <xs:element name="payload" type="events:EventPayloadType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="eventId" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="EventMetadataType">
        <xs:sequence>
            <!-- Additional headers -->
            <xs:element name="headers" type="events:QueryParamsType" minOccurs="0"/>
        </xs:sequence>
        <!-- When the event occurred (Unix timestamp ms) -->
        <xs:attribute name="timestamp" type="xs:long" use="required"/>
        <!-- Event source identifier -->
        <xs:attribute name="sourceId" type="xs:string"/>
        <!-- Source type: mcp-server, plugin, system, user -->
        <xs:attribute name="sourceType" type="events:SourceTypeEnum"/>
        <!-- Correlation ID for tracing -->
        <xs:attribute name="correlationId" type="xs:string"/>
        <!-- Causation ID -->
        <xs:attribute name="causationId" type="xs:string"/>
        <!-- Event version -->
        <xs:attribute name="version" type="xs:int" default="1"/>
        <!-- Priority -->
        <xs:attribute name="priority" type="events:EventPriorityEnum" default="normal"/>
        <!-- User/session -->
        <xs:attribute name="userId" type="xs:string"/>
        <xs:attribute name="sessionId" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="SourceTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="system"/>
            <xs:enumeration value="user"/>
            <xs:enumeration value="mcp-server"/>
            <xs:enumeration value="mcp-tool"/>
            <xs:enumeration value="plugin"/>
            <xs:enumeration value="agent"/>
            <xs:enumeration value="ui-component"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="EventPriorityEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="low"/>
            <xs:enumeration value="normal"/>
            <xs:enumeration value="high"/>
            <xs:enumeration value="critical"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- =========================================================================
         EVENT PAYLOAD
         Choice of typed payloads for common event types
         ========================================================================= -->

    <xs:complexType name="EventPayloadType">
        <xs:choice>
            <!-- Generic payload as base64 -->
            <xs:element name="data" type="xs:base64Binary"/>
            <!-- Typed payloads -->
            <xs:element name="clusterNode" type="events:ClusterNodeEventType"/>
            <xs:element name="component" type="events:ComponentEventType"/>
            <xs:element name="mcpServer" type="events:McpServerEventType"/>
            <xs:element name="mcpTool" type="events:McpToolEventType"/>
            <xs:element name="agent" type="events:AgentEventType"/>
            <xs:element name="task" type="events:TaskEventType"/>
        </xs:choice>
    </xs:complexType>

    <!-- =========================================================================
         TYPED EVENT PAYLOADS
         ========================================================================= -->

    <!-- Cluster Node Events -->
    <xs:complexType name="ClusterNodeEventType">
        <xs:sequence>
            <xs:element name="changedFields" type="events:ChangedFieldsType" minOccurs="0"/>
            <xs:element name="nodeData" type="xs:base64Binary" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="nodeId" type="xs:string" use="required"/>
        <xs:attribute name="nodeType" type="events:ClusterNodeTypeEnum"/>
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="state" type="events:ClusterNodeStateEnum"/>
        <!-- For moved events -->
        <xs:attribute name="oldParentId" type="xs:string"/>
        <xs:attribute name="newParentId" type="xs:string"/>
        <xs:attribute name="oldSiblingOrder" type="xs:int"/>
        <xs:attribute name="newSiblingOrder" type="xs:int"/>
        <!-- For renamed events -->
        <xs:attribute name="oldName" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="ClusterNodeTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="project"/>
            <xs:enumeration value="scene"/>
            <xs:enumeration value="folder"/>
            <xs:enumeration value="document"/>
            <xs:enumeration value="asset"/>
            <xs:enumeration value="group"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ClusterNodeStateEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="active"/>
            <xs:enumeration value="collapsed"/>
            <xs:enumeration value="hidden"/>
            <xs:enumeration value="deleted"/>
            <xs:enumeration value="archived"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Component Events -->
    <xs:complexType name="ComponentEventType">
        <xs:sequence>
            <xs:element name="changedFields" type="events:ChangedFieldsType" minOccurs="0"/>
            <xs:element name="oldData" type="xs:base64Binary" minOccurs="0"/>
            <xs:element name="newData" type="xs:base64Binary" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="componentId" type="xs:string" use="required"/>
        <xs:attribute name="clusterNodeId" type="xs:string"/>
        <xs:attribute name="componentType" type="xs:string"/>
        <xs:attribute name="state" type="events:ComponentStateEnum"/>
    </xs:complexType>

    <xs:simpleType name="ComponentStateEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="enabled"/>
            <xs:enumeration value="disabled"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- MCP Server Events -->
    <xs:complexType name="McpServerEventType">
        <xs:sequence>
            <xs:element name="toolNames" type="events:ToolNamesType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="serverId" type="xs:string" use="required"/>
        <xs:attribute name="serverName" type="xs:string"/>
        <xs:attribute name="state" type="events:McpServerStateEnum"/>
        <xs:attribute name="transportType" type="xs:string"/>
        <xs:attribute name="endpoint" type="xs:string"/>
        <xs:attribute name="errorCode" type="xs:string"/>
        <xs:attribute name="errorMessage" type="xs:string"/>
        <xs:attribute name="healthy" type="xs:boolean"/>
        <xs:attribute name="latencyMs" type="xs:long"/>
    </xs:complexType>

    <xs:complexType name="ToolNamesType">
        <xs:sequence>
            <xs:element name="tool" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="McpServerStateEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="stopped"/>
            <xs:enumeration value="starting"/>
            <xs:enumeration value="running"/>
            <xs:enumeration value="stopping"/>
            <xs:enumeration value="error"/>
            <xs:enumeration value="unresponsive"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- MCP Tool Events -->
    <xs:complexType name="McpToolEventType">
        <xs:sequence>
            <xs:element name="inputParams" type="xs:base64Binary" minOccurs="0"/>
            <xs:element name="outputResult" type="xs:base64Binary" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="toolName" type="xs:string" use="required"/>
        <xs:attribute name="serverId" type="xs:string"/>
        <xs:attribute name="invocationId" type="xs:string"/>
        <xs:attribute name="startedAt" type="xs:long"/>
        <xs:attribute name="completedAt" type="xs:long"/>
        <xs:attribute name="durationMs" type="xs:long"/>
        <xs:attribute name="errorCode" type="xs:string"/>
        <xs:attribute name="errorMessage" type="xs:string"/>
        <xs:attribute name="userId" type="xs:string"/>
        <xs:attribute name="undoable" type="xs:boolean"/>
    </xs:complexType>

    <!-- Agent Events -->
    <xs:complexType name="AgentEventType">
        <xs:sequence>
            <xs:element name="capabilities" type="events:CapabilitiesType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="agentId" type="xs:string" use="required"/>
        <xs:attribute name="agentType" type="xs:string"/>
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="state" type="events:AgentStateEnum"/>
        <xs:attribute name="errorCode" type="xs:string"/>
        <xs:attribute name="errorMessage" type="xs:string"/>
        <xs:attribute name="activeTasks" type="xs:int"/>
        <xs:attribute name="queuedTasks" type="xs:int"/>
    </xs:complexType>

    <xs:complexType name="CapabilitiesType">
        <xs:sequence>
            <xs:element name="capability" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="AgentStateEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="idle"/>
            <xs:enumeration value="busy"/>
            <xs:enumeration value="overloaded"/>
            <xs:enumeration value="error"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Task Events -->
    <xs:complexType name="TaskEventType">
        <xs:sequence>
            <xs:element name="resultData" type="xs:base64Binary" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="taskId" type="xs:string" use="required"/>
        <xs:attribute name="agentId" type="xs:string"/>
        <xs:attribute name="taskType" type="xs:string"/>
        <xs:attribute name="status" type="events:TaskStatusEnum"/>
        <xs:attribute name="priority" type="events:TaskPriorityEnum"/>
        <xs:attribute name="createdAt" type="xs:long"/>
        <xs:attribute name="startedAt" type="xs:long"/>
        <xs:attribute name="completedAt" type="xs:long"/>
        <xs:attribute name="progressPercent" type="xs:int"/>
        <xs:attribute name="progressMessage" type="xs:string"/>
        <xs:attribute name="errorCode" type="xs:string"/>
        <xs:attribute name="errorMessage" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="TaskStatusEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="pending"/>
            <xs:enumeration value="running"/>
            <xs:enumeration value="completed"/>
            <xs:enumeration value="failed"/>
            <xs:enumeration value="cancelled"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TaskPriorityEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="low"/>
            <xs:enumeration value="normal"/>
            <xs:enumeration value="high"/>
            <xs:enumeration value="critical"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Changed Fields Helper -->
    <xs:complexType name="ChangedFieldsType">
        <xs:sequence>
            <xs:element name="field" type="xs:string" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- =========================================================================
         EVENT BATCH
         ========================================================================= -->

    <xs:complexType name="EventBatchType">
        <xs:sequence>
            <xs:element name="event" type="events:EventType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="batchId" type="xs:string" use="required"/>
        <xs:attribute name="timestamp" type="xs:long"/>
    </xs:complexType>

    <!-- =========================================================================
         SUBSCRIPTION
         ========================================================================= -->

    <xs:complexType name="SubscriptionType">
        <xs:sequence>
            <xs:element name="pattern" type="events:SubscriptionPatternType"/>
            <xs:element name="queryFilter" type="events:QueryParamsType" minOccurs="0"/>
            <xs:element name="delivery" type="events:DeliveryOptionsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="subscriptionId" type="xs:string" use="required"/>
        <xs:attribute name="subscriberId" type="xs:string"/>
        <xs:attribute name="subscriberType" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="SubscriptionPatternType">
        <!-- Scheme pattern (* for any) -->
        <xs:attribute name="scheme" type="xs:string" default="*"/>
        <!-- Path pattern (supports * and ** wildcards) -->
        <xs:attribute name="path" type="xs:string" default="**"/>
        <!-- Action pattern (* for any) -->
        <xs:attribute name="action" type="xs:string" default="*"/>
        <!-- Subject pattern -->
        <xs:attribute name="subject" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="DeliveryOptionsType">
        <xs:attribute name="mode" type="events:DeliveryModeEnum" default="immediate"/>
        <xs:attribute name="batchSize" type="xs:int"/>
        <xs:attribute name="batchTimeoutMs" type="xs:int"/>
        <xs:attribute name="maxRetries" type="xs:int"/>
        <xs:attribute name="retryDelayMs" type="xs:int"/>
        <xs:attribute name="minPriority" type="events:EventPriorityEnum"/>
    </xs:complexType>

    <xs:simpleType name="DeliveryModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="immediate"/>
            <xs:enumeration value="batched"/>
            <xs:enumeration value="poll"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- =========================================================================
         EVENT STREAM (for examples)
         ========================================================================= -->

    <xs:complexType name="EventStreamType">
        <xs:sequence>
            <xs:element name="event" type="events:EventType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="description" type="xs:string"/>
    </xs:complexType>

    <!-- =========================================================================
         WELL-KNOWN ACTIONS
         ========================================================================= -->

    <xs:simpleType name="EventActionEnum">
        <xs:restriction base="xs:string">
            <!-- Lifecycle -->
            <xs:enumeration value="created"/>
            <xs:enumeration value="updated"/>
            <xs:enumeration value="deleted"/>
            <!-- State transitions -->
            <xs:enumeration value="started"/>
            <xs:enumeration value="stopped"/>
            <xs:enumeration value="paused"/>
            <xs:enumeration value="resumed"/>
            <!-- Connection -->
            <xs:enumeration value="connected"/>
            <xs:enumeration value="disconnected"/>
            <xs:enumeration value="reconnecting"/>
            <!-- Execution -->
            <xs:enumeration value="invoked"/>
            <xs:enumeration value="completed"/>
            <xs:enumeration value="failed"/>
            <xs:enumeration value="cancelled"/>
            <xs:enumeration value="timeout"/>
            <!-- Progress -->
            <xs:enumeration value="progress"/>
            <xs:enumeration value="queued"/>
            <!-- Data -->
            <xs:enumeration value="moved"/>
            <xs:enumeration value="renamed"/>
            <xs:enumeration value="copied"/>
            <!-- State -->
            <xs:enumeration value="enabled"/>
            <xs:enumeration value="disabled"/>
            <!-- Health -->
            <xs:enumeration value="health"/>
            <xs:enumeration value="error"/>
            <xs:enumeration value="warning"/>
            <!-- Registration -->
            <xs:enumeration value="registered"/>
            <xs:enumeration value="unregistered"/>
            <!-- UI -->
            <xs:enumeration value="selected"/>
            <xs:enumeration value="deselected"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>