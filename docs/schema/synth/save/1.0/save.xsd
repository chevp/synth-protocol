<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:save="https://chevp.github.io/synth-protocol/schema/synth/save/1.0"
           xmlns:common="https://chevp.github.io/synth-protocol/schema/synth/common-types"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/save/1.0"
           elementFormDefault="qualified">

    <xs:import namespace="https://chevp.github.io/synth-protocol/schema/synth/common-types"
               schemaLocation="../../common-types.xsd"/>

    <!-- =========================================================================
         SYNTH SAVE SCHEMA
         Save-Slots, Snapshots, Versioning, Migrations.
         Root element: <synthSave>

         Zwei Use-Cases:
         - Konfiguration (was wird gespeichert, wieviele Slots, wo)
         - Snapshot (konkreter Speicherstand zu einem Zeitpunkt)
         ========================================================================= -->

    <xs:element name="synthSave" type="save:SynthSaveType"/>

    <xs:complexType name="SynthSaveType">
        <xs:choice>
            <xs:element name="config" type="save:SaveConfigType"/>
            <xs:element name="snapshot" type="save:SnapshotType"/>
        </xs:choice>
        <xs:attribute name="version" type="xs:string" use="required"/>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- ===== Save-Configuration ===== -->
    <xs:complexType name="SaveConfigType">
        <xs:sequence>
            <xs:element name="slots" type="save:SlotsType"/>
            <xs:element name="autosave" type="save:AutosaveType" minOccurs="0"/>
            <xs:element name="sections" type="save:SectionsType"/>
            <xs:element name="migrations" type="save:MigrationsType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SlotsType">
        <xs:attribute name="manual" type="xs:int" default="10"/>
        <xs:attribute name="quicksave" type="xs:int" default="1"/>
        <xs:attribute name="autosave" type="xs:int" default="3"/>
        <xs:attribute name="storage" type="save:StorageEnum" default="filesystem"/>
        <xs:attribute name="path" type="xs:string"/>
        <xs:attribute name="encryption" type="xs:boolean" default="false"/>
        <xs:attribute name="compression" type="save:CompressionEnum" default="zstd"/>
    </xs:complexType>

    <xs:simpleType name="StorageEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="filesystem"/>
            <xs:enumeration value="sqlite"/>
            <xs:enumeration value="cloud"/>
            <xs:enumeration value="hybrid"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CompressionEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="none"/>
            <xs:enumeration value="zstd"/>
            <xs:enumeration value="gzip"/>
            <xs:enumeration value="lz4"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="AutosaveType">
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
        <xs:attribute name="intervalSec" type="xs:int" default="300"/>
        <xs:attribute name="onSceneChange" type="xs:boolean" default="true"/>
        <xs:attribute name="onQuit" type="xs:boolean" default="true"/>
    </xs:complexType>

    <!-- Sections: was wird gespeichert (Player, World, Quests, ...) -->
    <xs:complexType name="SectionsType">
        <xs:sequence>
            <xs:element name="section" type="save:SectionType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SectionType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="serviceRef" type="xs:string" use="required"/>
        <xs:attribute name="required" type="xs:boolean" default="true"/>
        <xs:attribute name="format" type="save:SectionFormatEnum" default="json"/>
    </xs:complexType>

    <xs:simpleType name="SectionFormatEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="json"/>
            <xs:enumeration value="xml"/>
            <xs:enumeration value="binary"/>
            <xs:enumeration value="msgpack"/>
            <xs:enumeration value="protobuf"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Migrations ===== -->
    <xs:complexType name="MigrationsType">
        <xs:sequence>
            <xs:element name="migration" type="save:MigrationType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MigrationType">
        <xs:attribute name="from" type="xs:string" use="required"/>
        <xs:attribute name="to" type="xs:string" use="required"/>
        <xs:attribute name="script" type="xs:string" use="required"/>
        <xs:attribute name="lossy" type="xs:boolean" default="false"/>
    </xs:complexType>

    <!-- ===== Snapshot (konkreter Speicherstand) ===== -->
    <xs:complexType name="SnapshotType">
        <xs:sequence>
            <xs:element name="meta" type="save:SnapshotMetaType"/>
            <xs:element name="sceneRef" type="save:SceneRefType" minOccurs="0"/>
            <xs:element name="data" type="save:SnapshotDataType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="slot" type="xs:string" use="required"/>
        <xs:attribute name="dataVersion" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="SnapshotMetaType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="created" type="xs:dateTime"/>
            <xs:element name="thumbnail" type="xs:string" minOccurs="0"/>
            <xs:element name="appVersion" type="xs:string"/>
            <xs:element name="properties" type="common:PropertiesType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SceneRefType">
        <xs:attribute name="uri" type="xs:anyURI" use="required"/>
        <xs:attribute name="spawnPoint" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="SnapshotDataType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="section" type="xs:string" use="required"/>
                <xs:attribute name="format" type="save:SectionFormatEnum" default="json"/>
                <xs:attribute name="encoding" type="save:EncodingEnum" default="utf8"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:simpleType name="EncodingEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="utf8"/>
            <xs:enumeration value="base64"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
