<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:runtime="https://chevp.github.io/synth-protocol/schema/synth/runtime/1.0/logic"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/runtime/1.0/logic"
           elementFormDefault="qualified">

    <!-- =========================================================================
         SYNTH RUNTIME LOGIC SCHEMA
         Runtime initialization for game logic / backend servers
         Root element: <synthRuntimeLogic>

         Philosophy: Domain-driven, NOT over-engineered
         - Simple configuration (NOT abstraction layers)
         - Direct database/hub connections

         CRITICAL DISTINCTION:
         - synthRuntimeRenderer = Renderer initialization (Vulkan, OpenGL, etc.)
         - synthRuntimeLogic = Game logic / backend initialization

         This schema is for backend services, NOT renderer clients!
         ========================================================================= -->

    <!-- Root Element -->
    <xs:element name="synth-runtime-logic" type="runtime:SynthRuntimeLogicType"/>

    <!-- Runtime Logic Configuration -->
    <xs:complexType name="SynthRuntimeLogicType">
        <xs:sequence>
            <!-- Metadata -->
            <xs:element name="metadata" type="runtime:MetadataType"/>

            <!-- Hub Connection -->
            <xs:element name="hub" type="runtime:HubType" minOccurs="0"/>

            <!-- Database Configuration -->
            <xs:element name="database" type="runtime:DatabaseType" minOccurs="0"/>

            <!-- Server Configuration -->
            <xs:element name="server" type="runtime:ServerType"/>

            <!-- Game Logic Settings -->
            <xs:element name="game" type="runtime:GameType" minOccurs="0"/>

            <!-- Runtime Settings -->
            <xs:element name="settings" type="runtime:SettingsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Metadata -->
    <xs:complexType name="MetadataType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="service" type="xs:string"/>
            <xs:element name="platform" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Hub Connection -->
    <xs:complexType name="HubType">
        <xs:attribute name="url" type="xs:anyURI" use="required"/>
        <xs:attribute name="mode" type="runtime:HubModeEnum" default="websocket"/>
        <xs:attribute name="reconnect" type="xs:boolean" default="true"/>
    </xs:complexType>

    <xs:simpleType name="HubModeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="websocket"/>
            <xs:enumeration value="polling"/>
            <xs:enumeration value="grpc"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Database Configuration -->
    <xs:complexType name="DatabaseType">
        <xs:sequence>
            <xs:element name="connection" type="runtime:ConnectionType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="type" type="runtime:DatabaseTypeEnum" use="required"/>
        <xs:attribute name="path" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="DatabaseTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="sqlite"/>
            <xs:enumeration value="postgresql"/>
            <xs:enumeration value="mysql"/>
            <xs:enumeration value="mongodb"/>
            <xs:enumeration value="redis"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="ConnectionType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="host" type="xs:string"/>
        <xs:attribute name="port" type="xs:int"/>
        <xs:attribute name="database" type="xs:string"/>
        <xs:attribute name="username" type="xs:string"/>
        <xs:attribute name="pool-size" type="xs:int" default="10"/>
    </xs:complexType>

    <!-- Server Configuration -->
    <xs:complexType name="ServerType">
        <xs:sequence>
            <xs:element name="endpoint" type="runtime:EndpointType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="EndpointType">
        <xs:attribute name="type" type="runtime:EndpointTypeEnum" use="required"/>
        <xs:attribute name="host" type="xs:string" default="localhost"/>
        <xs:attribute name="port" type="xs:int" use="required"/>
        <xs:attribute name="cors" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:simpleType name="EndpointTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="http"/>
            <xs:enumeration value="websocket"/>
            <xs:enumeration value="grpc"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Game Logic Configuration -->
    <xs:complexType name="GameType">
        <xs:sequence>
            <xs:element name="tick-rate" type="xs:int" default="60"/>
            <xs:element name="max-players" type="xs:int" default="100"/>
            <xs:element name="save-interval" type="xs:int" default="300"/>
            <xs:element name="plugins" type="runtime:PluginsType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PluginsType">
        <xs:sequence>
            <xs:element name="plugin" type="runtime:PluginType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PluginType">
        <xs:attribute name="id" type="xs:string" use="required"/>
        <xs:attribute name="enabled" type="xs:boolean" default="true"/>
    </xs:complexType>

    <!-- Runtime Settings -->
    <xs:complexType name="SettingsType">
        <xs:sequence>
            <xs:element name="setting" type="runtime:SettingType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SettingType">
        <xs:attribute name="key" type="xs:string" use="required"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

</xs:schema>
