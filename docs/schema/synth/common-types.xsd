<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:common="https://chevp.github.io/synth-protocol/schema/synth/common-types"
           targetNamespace="https://chevp.github.io/synth-protocol/schema/synth/common-types"
           elementFormDefault="qualified">

    <!-- =========================================================================
         SYNTH COMMON TYPES
         Shared types used across all synth-protocol schemas.
         Import this schema to avoid duplicating Vec3, Property, Settings, etc.
         ========================================================================= -->

    <!-- ===== Math Types ===== -->

    <!-- Vector3 as x/y/z attributes: <position x="0" y="3" z="15"/> -->
    <xs:complexType name="Vec3Type">
        <xs:attribute name="x" type="xs:float" use="required"/>
        <xs:attribute name="y" type="xs:float" use="required"/>
        <xs:attribute name="z" type="xs:float" use="required"/>
    </xs:complexType>

    <!-- Vector2 as x/y attributes -->
    <xs:complexType name="Vec2Type">
        <xs:attribute name="x" type="xs:float" use="required"/>
        <xs:attribute name="y" type="xs:float" use="required"/>
    </xs:complexType>

    <!-- Transform: position + rotation + scale -->
    <xs:complexType name="TransformType">
        <xs:all>
            <xs:element name="position" type="common:Vec3Type" minOccurs="0"/>
            <xs:element name="rotation" type="common:Vec3Type" minOccurs="0"/>
            <xs:element name="scale" type="common:Vec3Type" minOccurs="0"/>
        </xs:all>
    </xs:complexType>

    <!-- ===== Property System ===== -->

    <!-- Property value types supported across all schemas -->
    <xs:simpleType name="PropertyTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="string"/>
            <xs:enumeration value="int"/>
            <xs:enumeration value="float"/>
            <xs:enumeration value="bool"/>
            <xs:enumeration value="vec2"/>  <!-- Format: "x y" (space-separated) -->
            <xs:enumeration value="vec3"/>  <!-- Format: "x y z" (space-separated) -->
            <xs:enumeration value="color"/> <!-- Format: "#RRGGBB" or "r g b a" (space-separated RGBA) -->
        </xs:restriction>
    </xs:simpleType>

    <!-- Single property: <property name="speed" type="float" value="4.0"/>
         Vector properties use space-separated values:
           <property name="sunDirection" type="vec3" value="0.3 -0.7 0.5"/>
           <property name="offset" type="vec2" value="10 20"/>
         Colors can use hex or space-separated RGBA:
           <property name="tint" type="color" value="#4CAF50"/>
           <property name="baseColor" type="color" value="0.8 0.8 0.8 1.0"/>
    -->
    <xs:complexType name="PropertyType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="type" type="common:PropertyTypeEnum" use="required"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Properties container -->
    <xs:complexType name="PropertiesType">
        <xs:sequence>
            <xs:element name="property" type="common:PropertyType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ===== Settings System ===== -->

    <!-- Single setting: <setting key="maxFrames" value="2"/>
         Vector settings use space-separated values:
           <setting key="camera.defaultPosition" value="0 3 15"/>
           <setting key="gravity" value="0 -9.81 0"/>
    -->
    <xs:complexType name="SettingType">
        <xs:attribute name="key" type="xs:string" use="required"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Settings container -->
    <xs:complexType name="SettingsType">
        <xs:sequence>
            <xs:element name="setting" type="common:SettingType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ===== Config Map ===== -->

    <!-- Config entry: <entry key="theme">dark</entry> -->
    <xs:complexType name="ConfigEntryType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="key" type="xs:string" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Config map container -->
    <xs:complexType name="ConfigMapType">
        <xs:sequence>
            <xs:element name="entry" type="common:ConfigEntryType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ===== Metadata Base ===== -->

    <!-- Base metadata: name + optional description (extended per schema) -->
    <xs:complexType name="MetadataType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ===== Mesh Reference ===== -->

    <!-- Mesh ref: <mesh ref="shared/models/building.gltf"/> -->
    <xs:complexType name="MeshRefType">
        <xs:attribute name="ref" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- ===== Log Level ===== -->

    <xs:simpleType name="LogLevelEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="TRACE"/>
            <xs:enumeration value="DEBUG"/>
            <xs:enumeration value="INFO"/>
            <xs:enumeration value="WARN"/>
            <xs:enumeration value="ERROR"/>
            <xs:enumeration value="FATAL"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
