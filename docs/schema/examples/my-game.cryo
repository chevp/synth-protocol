<?xml version="1.0" encoding="UTF-8"?>
<!--
    SYNTH GAME PROJECT - Complete Development Environment

    Purpose: Developer entry point - starts backend AND renderer

    Workflow:
      1. Double-click my-game.cryo
      2. frost-studio.exe detects .cryo extension
      3. Starts runtime-synth-game.synth (Backend)
      4. Waits for backend ready
      5. Starts runtime-frost-studio.frost (Renderer with Editor)
-->
<synth version="1.0"
       xmlns="https://chevp.github.io/synth-protocol/schema/synth/1.0">
<game-project version="1.0">

    <metadata>
        <name>My Awesome Game</name>
        <description>A complete game development project with backend and renderer</description>
        <version>0.1.0</version>
        <author>chevp</author>
        <created>2026-02-08T15:00:00Z</created>
    </metadata>

    <!-- Backend Configuration (C++ nuna-runtime) -->
    <backend>
        <!-- Path relative to .cryo file -->
        <runtime>runtime-synth-game.synth</runtime>

        <!-- Auto-start backend when project opens -->
        <autoStart>true</autoStart>

        <!-- Wait for backend to be ready before starting renderer -->
        <waitForReady>true</waitForReady>

        <!-- Timeout in seconds -->
        <startupTimeout>30</startupTimeout>
    </backend>

    <!-- Renderer Configuration (C++ Vulkan Renderer) -->
    <renderer>
        <!-- Path relative to .cryo file -->
        <runtime>runtime-frost-studio.frost</runtime>

        <!-- Auto-start renderer after backend is ready -->
        <autoStart>true</autoStart>
    </renderer>

    <!-- Project Paths (all relative to .cryo file) -->
    <paths>
        <assets>assets/src</assets>
        <scenes>assets/src/scenes</scenes>
        <components>assets/src/components</components>
        <scripts>scripts</scripts>
        <data>data</data>
        <config>config</config>
    </paths>

    <!-- Launcher Configuration -->
    <launcher>
        <!-- Startup order: sequential = backend first, then renderer -->
        <startupOrder>sequential</startupOrder>

        <!-- Show console windows for debugging -->
        <showConsole>true</showConsole>

        <!-- Working directory (defaults to .cryo file directory) -->
        <workingDirectory>.</workingDirectory>
    </launcher>

</game-project>
</synth>
