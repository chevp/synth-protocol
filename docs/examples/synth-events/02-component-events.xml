<?xml version="1.0" encoding="UTF-8"?>
<!--
    SYNTH EVENTS - Component Modification Examples
    URI Format: scheme://path/action#subject?query

    These examples demonstrate events for component operations
    (transform, materials, scripts, etc.)
-->
<eventStream xmlns="https://chevp.github.io/synth-protocol/schema/synth/events/1.0"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://chevp.github.io/synth-protocol/schema/synth/events/1.0 ../../schema/synth/events/1.0/events.xsd"
             name="Component Events"
             description="Example events for component modifications">

    <!-- =================================================================== -->
    <!-- Transform Component Created -->
    <!-- URI: synth://component/created#comp_transform_tree?node=node_tree_01 -->
    <!-- =================================================================== -->
    <event eventId="evt_101">
        <uri scheme="synth" path="component" action="created" subject="comp_transform_tree">
            <query>
                <param key="node">node_tree_01</param>
                <param key="type">transform</param>
                <param key="scene">scene_outdoor</param>
            </query>
        </uri>
        <metadata timestamp="1733400100000"
                  sourceId="mcp_playground"
                  sourceType="mcp-server"
                  version="1"
                  priority="normal"/>
        <payload>
            <component componentId="comp_transform_tree"
                       clusterNodeId="node_tree_01"
                       componentType="transform"
                       state="enabled">
                <!-- Base64 encoded: {"position":{"x":10,"y":0,"z":5},"rotation":{"x":0,"y":0,"z":0,"w":1},"scale":{"x":1,"y":1,"z":1}} -->
                <newData>eyJwb3NpdGlvbiI6eyJ4IjoxMCwieSI6MCwieiI6NX0sInJvdGF0aW9uIjp7IngiOjAsInkiOjAsInoiOjAsInciOjF9LCJzY2FsZSI6eyJ4IjoxLCJ5IjoxLCJ6IjoxfX0=</newData>
            </component>
        </payload>
    </event>

    <!-- =================================================================== -->
    <!-- Transform Position Updated -->
    <!-- URI: synth://component/updated#comp_transform_tree?field=position -->
    <!-- =================================================================== -->
    <event eventId="evt_102">
        <uri scheme="synth" path="component" action="updated" subject="comp_transform_tree">
            <query>
                <param key="node">node_tree_01</param>
                <param key="type">transform</param>
                <param key="field">position</param>
            </query>
        </uri>
        <metadata timestamp="1733400101000"
                  sourceId="tool_move"
                  sourceType="mcp-tool"
                  correlationId="drag_session_001"
                  version="1"
                  priority="high"/>
        <payload>
            <component componentId="comp_transform_tree"
                       clusterNodeId="node_tree_01"
                       componentType="transform"
                       state="enabled">
                <changedFields>
                    <field>position</field>
                </changedFields>
            </component>
        </payload>
    </event>

    <!-- =================================================================== -->
    <!-- Transform Rotation Updated (Batch during drag) -->
    <!-- URI: synth://component/updated#comp_transform_tree?field=rotation -->
    <!-- =================================================================== -->
    <event eventId="evt_103">
        <uri scheme="synth" path="component" action="updated" subject="comp_transform_tree">
            <query>
                <param key="node">node_tree_01</param>
                <param key="type">transform</param>
                <param key="field">rotation</param>
                <param key="batch">true</param>
            </query>
        </uri>
        <metadata timestamp="1733400101500"
                  sourceId="tool_rotate"
                  sourceType="mcp-tool"
                  correlationId="rotate_session_001"
                  version="1"
                  priority="normal"/>
        <payload>
            <component componentId="comp_transform_tree"
                       clusterNodeId="node_tree_01"
                       componentType="transform"
                       state="enabled">
                <changedFields>
                    <field>rotation</field>
                </changedFields>
            </component>
        </payload>
    </event>

    <!-- =================================================================== -->
    <!-- Material Component Added -->
    <!-- URI: synth://component/created#comp_material_tree?node=node_tree_01 -->
    <!-- =================================================================== -->
    <event eventId="evt_104">
        <uri scheme="synth" path="component" action="created" subject="comp_material_tree">
            <query>
                <param key="node">node_tree_01</param>
                <param key="type">material</param>
                <param key="material_name">bark_pbr</param>
            </query>
        </uri>
        <metadata timestamp="1733400102000"
                  sourceId="mcp_materials"
                  sourceType="mcp-server"
                  version="1"
                  priority="normal"/>
        <payload>
            <component componentId="comp_material_tree"
                       clusterNodeId="node_tree_01"
                       componentType="material"
                       state="enabled"/>
        </payload>
    </event>

    <!-- =================================================================== -->
    <!-- Component Disabled -->
    <!-- URI: synth://component/disabled#comp_material_tree -->
    <!-- =================================================================== -->
    <event eventId="evt_105">
        <uri scheme="synth" path="component" action="disabled" subject="comp_material_tree">
            <query>
                <param key="node">node_tree_01</param>
                <param key="type">material</param>
            </query>
        </uri>
        <metadata timestamp="1733400103000"
                  sourceId="ui_inspector"
                  sourceType="user"
                  version="1"
                  priority="low"/>
        <payload>
            <component componentId="comp_material_tree"
                       clusterNodeId="node_tree_01"
                       componentType="material"
                       state="disabled">
                <changedFields>
                    <field>state</field>
                </changedFields>
            </component>
        </payload>
    </event>

    <!-- =================================================================== -->
    <!-- Component Enabled -->
    <!-- URI: synth://component/enabled#comp_material_tree -->
    <!-- =================================================================== -->
    <event eventId="evt_106">
        <uri scheme="synth" path="component" action="enabled" subject="comp_material_tree">
            <query>
                <param key="node">node_tree_01</param>
            </query>
        </uri>
        <metadata timestamp="1733400104000"
                  sourceId="ui_inspector"
                  sourceType="user"
                  version="1"
                  priority="low"/>
        <payload>
            <component componentId="comp_material_tree"
                       clusterNodeId="node_tree_01"
                       componentType="material"
                       state="enabled">
                <changedFields>
                    <field>state</field>
                </changedFields>
            </component>
        </payload>
    </event>

    <!-- =================================================================== -->
    <!-- Component Deleted -->
    <!-- URI: synth://component/deleted#comp_material_tree -->
    <!-- =================================================================== -->
    <event eventId="evt_107">
        <uri scheme="synth" path="component" action="deleted" subject="comp_material_tree">
            <query>
                <param key="node">node_tree_01</param>
                <param key="type">material</param>
            </query>
        </uri>
        <metadata timestamp="1733400105000"
                  sourceId="tool_remove_component"
                  sourceType="mcp-tool"
                  version="1"
                  priority="normal"/>
        <payload>
            <component componentId="comp_material_tree"
                       clusterNodeId="node_tree_01"
                       componentType="material"/>
        </payload>
    </event>

    <!-- =================================================================== -->
    <!-- Script Component Error -->
    <!-- URI: synth://component/error#comp_script_tree?error=compilation -->
    <!-- =================================================================== -->
    <event eventId="evt_108">
        <uri scheme="synth" path="component" action="error" subject="comp_script_tree">
            <query>
                <param key="node">node_tree_01</param>
                <param key="type">script</param>
                <param key="error">compilation</param>
                <param key="line">42</param>
            </query>
        </uri>
        <metadata timestamp="1733400106000"
                  sourceId="mcp_scripting"
                  sourceType="mcp-server"
                  version="1"
                  priority="high"/>
        <payload>
            <component componentId="comp_script_tree"
                       clusterNodeId="node_tree_01"
                       componentType="script"
                       state="disabled"/>
        </payload>
    </event>

    <!-- =================================================================== -->
    <!-- Mesh Component Updated (LOD changed) -->
    <!-- URI: synth://component/updated#comp_mesh_tree?field=lod -->
    <!-- =================================================================== -->
    <event eventId="evt_109">
        <uri scheme="synth" path="component" action="updated" subject="comp_mesh_tree">
            <query>
                <param key="node">node_tree_01</param>
                <param key="type">mesh</param>
                <param key="field">lod</param>
                <param key="old_lod">0</param>
                <param key="new_lod">2</param>
            </query>
        </uri>
        <metadata timestamp="1733400107000"
                  sourceId="lod_system"
                  sourceType="system"
                  version="1"
                  priority="low"/>
        <payload>
            <component componentId="comp_mesh_tree"
                       clusterNodeId="node_tree_01"
                       componentType="mesh"
                       state="enabled">
                <changedFields>
                    <field>active_lod</field>
                </changedFields>
            </component>
        </payload>
    </event>

    <!-- =================================================================== -->
    <!-- Animation Component Progress -->
    <!-- URI: synth://component/progress#comp_animation_tree -->
    <!-- =================================================================== -->
    <event eventId="evt_110">
        <uri scheme="synth" path="component" action="progress" subject="comp_animation_tree">
            <query>
                <param key="node">node_tree_01</param>
                <param key="type">animation</param>
                <param key="clip">wind_sway</param>
                <param key="time">1.5</param>
                <param key="normalized">0.75</param>
            </query>
        </uri>
        <metadata timestamp="1733400108000"
                  sourceId="animation_system"
                  sourceType="system"
                  version="1"
                  priority="low"/>
        <payload>
            <component componentId="comp_animation_tree"
                       clusterNodeId="node_tree_01"
                       componentType="animation"
                       state="enabled"/>
        </payload>
    </event>

</eventStream>