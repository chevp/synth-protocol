<?xml version="1.0" encoding="UTF-8"?>
<!--
    SYNTH EVENTS - Subscription Pattern Examples
    URI Pattern Format: scheme://path/action#subject

    Wildcards:
      *  - Matches exactly one segment or any action/subject
      ** - Matches zero or more path segments

    Examples:
      synth://cluster/node/*        - All node actions
      synth://**/*                  - All synth events
      *://mcp/**                    - All MCP events (any scheme)
-->
<subscriptions xmlns="https://chevp.github.io/synth-protocol/schema/synth/events/1.0"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://chevp.github.io/synth-protocol/schema/synth/events/1.0 ../../schema/synth/events/1.0/events.xsd">

    <!-- =================================================================== -->
    <!-- Subscribe to All Events in a Specific Scene -->
    <!-- Pattern: synth://**/*?scene=scene_outdoor -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_scene_outdoor"
                  subscriber-id="ui_scene_view"
                  subscriber-type="ui-component">
        <pattern scheme="synth" path="**" action="*"/>
        <query-filter>
            <param key="scene">scene_outdoor</param>
        </query-filter>
        <delivery mode="immediate" min-priority="low"/>
    </subscription>
    <!--
        Matches:
        - synth://cluster/node/created#node_x?scene=scene_outdoor
        - synth://component/updated#comp_y?scene=scene_outdoor
        - synth://scene/updated#scene_outdoor

        Does NOT match:
        - synth://cluster/node/created#node_x?scene=scene_indoor
        - nuna://mcp/server/started#mcp_vision
    -->

    <!-- =================================================================== -->
    <!-- Subscribe to All Cluster Node Events -->
    <!-- Pattern: synth://cluster/node/* -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_cluster_nodes"
                  subscriber-id="tree_view_panel"
                  subscriber-type="ui-component">
        <pattern scheme="synth" path="cluster/node" action="*"/>
        <delivery mode="immediate"/>
    </subscription>
    <!--
        Matches:
        - synth://cluster/node/created#node_123
        - synth://cluster/node/deleted#node_456
        - synth://cluster/node/moved#node_789
    -->

    <!-- =================================================================== -->
    <!-- Subscribe to MCP Server Health Events (Batched) -->
    <!-- Pattern: nuna://mcp/server/health -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_mcp_health"
                  subscriber-id="server_monitor"
                  subscriber-type="service">
        <pattern scheme="nuna" path="mcp/server" action="health"/>
        <delivery mode="batched"
                  batch-size="10"
                  batch-timeout-ms="5000"
                  min-priority="low"/>
    </subscription>

    <!-- =================================================================== -->
    <!-- Subscribe to All Error Events -->
    <!-- Pattern: *://**/error -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_all_errors"
                  subscriber-id="error_logger"
                  subscriber-type="service">
        <pattern scheme="*" path="**" action="error"/>
        <delivery mode="immediate"
                  max-retries="3"
                  retry-delay-ms="1000"/>
    </subscription>
    <!--
        Matches:
        - synth://component/error#comp_123
        - nuna://mcp/server/error#mcp_vision
        - synth://agent/error#agent_001
    -->

    <!-- =================================================================== -->
    <!-- Subscribe to High-Priority Events Only -->
    <!-- Pattern: *://**/* (all events, filtered by priority) -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_critical"
                  subscriber-id="alert_system"
                  subscriber-type="service">
        <pattern scheme="*" path="**" action="*"/>
        <delivery mode="immediate" min-priority="high"/>
    </subscription>

    <!-- =================================================================== -->
    <!-- Subscribe to Specific Node's Events -->
    <!-- Pattern: synth://**/*#node_tree_01 -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_node_inspector"
                  subscriber-id="inspector_panel"
                  subscriber-type="ui-component">
        <pattern scheme="synth" path="**" action="*" subject="node_tree_01"/>
        <delivery mode="immediate"/>
    </subscription>
    <!--
        Matches:
        - synth://cluster/node/updated#node_tree_01
        - synth://cluster/node/renamed#node_tree_01

        Does NOT match (different subject):
        - synth://component/updated#comp_transform_tree
    -->

    <!-- =================================================================== -->
    <!-- Subscribe to Components of a Specific Node -->
    <!-- Pattern: synth://component/*?node=node_tree_01 -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_node_components"
                  subscriber-id="component_panel"
                  subscriber-type="ui-component">
        <pattern scheme="synth" path="component" action="*"/>
        <query-filter>
            <param key="node">node_tree_01</param>
        </query-filter>
        <delivery mode="immediate"/>
    </subscription>

    <!-- =================================================================== -->
    <!-- Subscribe to MCP Tool Invocations (Audit Logging) -->
    <!-- Pattern: nuna://mcp/tool/* -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_audit_tools"
                  subscriber-id="audit_logger"
                  subscriber-type="service">
        <pattern scheme="nuna" path="mcp/tool" action="*"/>
        <delivery mode="batched"
                  batch-size="50"
                  batch-timeout-ms="10000"/>
    </subscription>

    <!-- =================================================================== -->
    <!-- Poll-Based Subscription for Background Worker -->
    <!-- Pattern: synth://agent/task/completed -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_worker_tasks"
                  subscriber-id="background_worker"
                  subscriber-type="worker">
        <pattern scheme="synth" path="agent/task" action="completed"/>
        <delivery mode="poll"/>
    </subscription>

    <!-- =================================================================== -->
    <!-- Subscribe to Transform Changes (for Undo/Redo) -->
    <!-- Pattern: synth://component/*?type=transform -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_transform_history"
                  subscriber-id="undo_manager"
                  subscriber-type="system">
        <pattern scheme="synth" path="component" action="*"/>
        <query-filter>
            <param key="type">transform</param>
        </query-filter>
        <delivery mode="immediate"/>
    </subscription>

    <!-- =================================================================== -->
    <!-- Subscribe to Selection Changes -->
    <!-- Pattern: synth://cluster/node/selected|deselected -->
    <!-- =================================================================== -->
    <subscription subscription-id="sub_selection"
                  subscriber-id="property_panel"
                  subscriber-type="ui-component">
        <pattern scheme="synth" path="cluster/node" action="selected"/>
        <delivery mode="immediate"/>
    </subscription>

    <subscription subscription-id="sub_deselection"
                  subscriber-id="property_panel"
                  subscriber-type="ui-component">
        <pattern scheme="synth" path="cluster/node" action="deselected"/>
        <delivery mode="immediate"/>
    </subscription>

</subscriptions>