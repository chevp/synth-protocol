            <!-- Blender Tab -->
            <tab>
                <id>tab_blender</id>
                <label>Blender</label>
                <icon>view_in_ar</icon>
                <order>1</order>
                <mcp-server-id>mcp_blender</mcp-server-id>
                <accent-color>#FF6B00</accent-color>
                <is-dev-tab>false</is-dev-tab>
                <groups>
                    <group>
                        <id>grp_scene</id>
