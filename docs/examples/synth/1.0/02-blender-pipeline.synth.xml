                                    <requires-selection>true</requires-selection>
                                </visibility>
                            </tool>
                        </tools>
                    </group>
                    <group>
                        <id>grp_modify</id>
                        <label>Modify</label>
                        <tools>
                            <tool>
                                <id>tool_add_modifier</id>
                                <mcp-tool-name>blender/object/add_modifier</mcp-tool-name>
                                <icon>tune</icon>
                                <label>Add Modifier</label>
                                <size>TOOL_SIZE_SMALL</size>
