                <is-dev-tab>false</is-dev-tab>
                <groups>
                    <group>
                        <id>grp_file</id>
                        <label>File</label>
                        <tools>
                            <tool>
                                <id>tool_open_blend</id>
                                <mcp-tool-name>blender/file/open</mcp-tool-name>
