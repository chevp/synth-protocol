    <!-- =================================================================== -->
    <!-- PIPELINES -->
    <!-- Automated workflows using synth-nodejs-plugins and synth-plugin-blender -->
    <!-- =================================================================== -->
    <pipelines>
        <!-- Blender to glTF Export Pipeline -->
        <pipeline>
            <entity-id>
                <uuid>pipeline_blend_to_gltf</uuid>
                <version>1</version>
                <created-at>1733580000000</created-at>
                <updated-at>1733580000000</updated-at>
            </entity-id>
            <name>Blender to glTF Export</name>
            <description>Export .blend files to optimized glTF format</description>
            <steps>
                <step>
                    <id>step_load_blend</id>
                    <order>1</order>
                    <mcp-tool-name>blender/file/open</mcp-tool-name>
                    <parameters>
                        <entry key="filepath" ref="$input.blendFile"/>
                    </parameters>
                </step>
                <step>
                    <id>step_apply_transforms</id>
                    <order>2</order>
                    <mcp-tool-name>blender/object/apply_transform</mcp-tool-name>
                    <parameters>
                        <entry key="all_objects">true</entry>
                        <entry key="location">true</entry>
                        <entry key="rotation">true</entry>
                        <entry key="scale">true</entry>
                    </parameters>
                    <depends-on>step_load_blend</depends-on>
                </step>
                <step>
                    <id>step_export_gltf</id>
                    <order>3</order>
                    <mcp-tool-name>blender/export/gltf</mcp-tool-name>
                    <parameters>
                        <entry key="filepath" ref="$output.gltfFile"/>
                        <entry key="export_format">GLB</entry>
                        <entry key="export_textures">true</entry>
                        <entry key="export_animations">true</entry>
                        <entry key="export_draco_mesh_compression">true</entry>
                    </parameters>
                    <depends-on>step_apply_transforms</depends-on>
                </step>
                <step>
                    <id>step_validate_gltf</id>
                    <order>4</order>
                    <mcp-tool-name>gltf/validate</mcp-tool-name>
                    <parameters>
                        <entry key="filepath" ref="$output.gltfFile"/>
                    </parameters>
                    <depends-on>step_export_gltf</depends-on>
                </step>
            </steps>
            <triggers>
                <trigger type="manual"/>
                <trigger type="file-watch" value="./models/*.blend"/>
            </triggers>
        </pipeline>

        <!-- LOD Generation Pipeline -->
        <pipeline>
            <entity-id>
                <uuid>pipeline_lod_generation</uuid>
                <version>1</version>
                <created-at>1733580000000</created-at>
                <updated-at>1733580000000</updated-at>
            </entity-id>
            <name>LOD Generation</name>
            <description>Generate Level of Detail meshes from high-poly source</description>
            <steps>
                <step>
                    <id>step_load</id>
                    <order>1</order>
                    <mcp-tool-name>blender/file/open</mcp-tool-name>
                    <parameters>
                        <entry key="filepath" ref="$input.blendFile"/>
                    </parameters>
                </step>
                <step>
                    <id>step_decimate_lod1</id>
                    <order>2</order>
                    <mcp-tool-name>blender/object/add_modifier</mcp-tool-name>
                    <parameters>
                        <entry key="modifier">DECIMATE</entry>
                        <entry key="ratio">0.5</entry>
                        <entry key="suffix">_LOD1</entry>
                    </parameters>
                    <depends-on>step_load</depends-on>
                </step>
                <step>
                    <id>step_decimate_lod2</id>
                    <order>3</order>
                    <mcp-tool-name>blender/object/add_modifier</mcp-tool-name>
                    <parameters>
                        <entry key="modifier">DECIMATE</entry>
                        <entry key="ratio">0.25</entry>
                        <entry key="suffix">_LOD2</entry>
                    </parameters>
                    <depends-on>step_decimate_lod1</depends-on>
                </step>
                <step>
                    <id>step_save</id>
                    <order>4</order>
                    <mcp-tool-name>blender/file/save</mcp-tool-name>
                    <parameters>
                        <entry key="filepath" ref="$output.blendFile"/>
                    </parameters>
                    <depends-on>step_decimate_lod2</depends-on>
                </step>
            </steps>
            <triggers>
                <trigger type="manual"/>
            </triggers>
        </pipeline>
    </pipelines>

