<?xml version="1.0" encoding="UTF-8"?>
<!--
  SYNTH PROJECT FILE FORMAT (.synth)
  Blender Integration Example

  This example demonstrates:
  - Loading .blend files through synth-nodejs-plugins
  - Using synth-plugin-blender for Blender automation
  - Pipeline for 3D asset processing and export

  Protocol Version: 1.1.0
  Schema: synth-protocol/synth-core/*.proto, synth-protocol/synth-agent/*.proto
-->
<synth version="1.0" xmlns="https://chevp.github.io/synth-protocol/schema/synth/1.0">
<project>

    <!-- =================================================================== -->
    <!-- FILE HEADER -->
    <!-- =================================================================== -->
    <header>
        <magic>SYNTH</magic>
        <format-version>1</format-version>
        <schema-version>1.0.0</schema-version>
        <created-at>1733580000000</created-at>
        <modified-at>1733580000000</modified-at>
        <compressed>false</compressed>
        <compression-type>NONE</compression-type>
    </header>

    <!-- =================================================================== -->
    <!-- PROJECT ROOT -->
    <!-- =================================================================== -->
    <metadata>
        <entity-id>
            <uuid>proj_blender_pipeline</uuid>
            <version>1</version>
            <created-at>1733580000000</created-at>
            <updated-at>1733580000000</updated-at>
        </entity-id>
        <name>Blender Asset Pipeline</name>
        <description>A project demonstrating Blender file processing with synth-nodejs-plugins and synth-plugin-blender</description>
        <schema-version>1.0.0</schema-version>
        <settings>
            <default-scene-id>scene_blender_workspace</default-scene-id>
            <thumbnail-asset-id>asset_thumbnail</thumbnail-asset-id>
            <auto-save-enabled>true</auto-save-enabled>
            <auto-save-interval-seconds>120</auto-save-interval-seconds>
            <custom-settings>
                <entry key="theme">dark</entry>
                <entry key="blender.version">4.0</entry>
                <entry key="blender.path">C:/Program Files/Blender Foundation/Blender 4.0/blender.exe</entry>
                <entry key="export.format">glTF</entry>
            </custom-settings>
        </settings>
        <last-opened-at>1733580000000</last-opened-at>
        <last-opened-by>artist</last-opened-by>
    </metadata>

    <!-- =================================================================== -->
    <!-- MCP SERVER REQUIREMENTS -->
    <!-- synth-nodejs-plugins provides the Node.js runtime for plugins -->
    <!-- synth-plugin-blender provides Blender-specific MCP tools -->
    <!-- =================================================================== -->
    <mcp-servers>
        <!-- Node.js Plugin Host - runs synth-nodejs-plugins -->
        <server>
            <entity-id>
                <uuid>mcp_nodejs_host</uuid>
                <version>1</version>
                <created-at>1733580000000</created-at>
                <updated-at>1733580000000</updated-at>
            </entity-id>
            <server-name>synth-nodejs-plugins</server-name>
            <version>1.0.0</version>
            <required>true</required>
            <source>MARKETPLACE_SOURCE_LOCAL</source>
            <config>
                <parameters>
                    <entry key="port">3100</entry>
                    <entry key="host">localhost</entry>
                    <entry key="pluginDir">./plugins</entry>
                </parameters>
                <auto-start>true</auto-start>
                <startup-timeout-ms>30000</startup-timeout-ms>
                <health-check-interval-ms>15000</health-check-interval-ms>
            </config>
        </server>

        <!-- Blender MCP Server - provided by synth-plugin-blender -->
        <server>
            <entity-id>
                <uuid>mcp_blender</uuid>
                <version>1</version>
                <created-at>1733580000000</created-at>
                <updated-at>1733580000000</updated-at>
            </entity-id>
            <server-name>synth-plugin-blender</server-name>
            <version>1.0.0</version>
            <required>true</required>
            <source>MARKETPLACE_SOURCE_DEV</source>
            <config>
                <parameters>
                    <entry key="blender.executable">C:/Program Files/Blender Foundation/Blender 4.0/blender.exe</entry>
                    <entry key="blender.background">true</entry>
                    <entry key="blender.pythonPath">./scripts/blender</entry>
                    <entry key="cache.enabled">true</entry>
                    <entry key="cache.dir">./cache/blender</entry>
                </parameters>
                <auto-start>true</auto-start>
                <startup-timeout-ms>60000</startup-timeout-ms>
                <health-check-interval-ms>30000</health-check-interval-ms>
            </config>
        </server>

        <!-- Vision Server for texture analysis (optional) -->
        <server>
            <entity-id>
                <uuid>mcp_vision</uuid>
                <version>1</version>
                <created-at>1733580000000</created-at>
                <updated-at>1733580000000</updated-at>
            </entity-id>
            <server-name>synth-vision</server-name>
            <version>1.0.0</version>
            <required>false</required>
            <source>MARKETPLACE_SOURCE_DEV</source>
            <config>
                <auto-start>false</auto-start>
            </config>
        </server>
    </mcp-servers>

    <!-- =================================================================== -->
    <!-- PLUGIN REQUIREMENTS -->
    <!-- =================================================================== -->
    <plugins>
        <!-- synth-plugin-blender: Blender automation and file handling -->
        <plugin>
            <entity-id>
                <uuid>plugin_blender</uuid>
                <version>1</version>
                <created-at>1733580000000</created-at>
                <updated-at>1733580000000</updated-at>
            </entity-id>
            <artifact>io.synth.plugins:synth-plugin-blender:1.0.0</artifact>
            <type>PLUGIN_TYPE_NODEJS</type>
            <source>MARKETPLACE_SOURCE_DEV</source>
            <mcp-bridge-server-id>mcp_blender</mcp-bridge-server-id>
            <provides-mcp-server>true</provides-mcp-server>
            <capabilities>
                <capability>blender.file.load</capability>
                <capability>blender.file.save</capability>
                <capability>blender.scene.list</capability>
                <capability>blender.object.list</capability>
                <capability>blender.export.gltf</capability>
                <capability>blender.export.fbx</capability>
                <capability>blender.render.preview</capability>
                <capability>blender.script.execute</capability>
            </capabilities>
        </plugin>

        <!-- synth-plugin-gltf: glTF processing -->
        <plugin>
            <entity-id>
                <uuid>plugin_gltf</uuid>
                <version>1</version>
                <created-at>1733580000000</created-at>
                <updated-at>1733580000000</updated-at>
            </entity-id>
            <artifact>io.synth.plugins:synth-plugin-gltf:1.0.0</artifact>
            <type>PLUGIN_TYPE_NODEJS</type>
            <source>MARKETPLACE_SOURCE_DEV</source>
            <mcp-bridge-server-id>mcp_nodejs_host</mcp-bridge-server-id>
            <provides-mcp-server>false</provides-mcp-server>
            <capabilities>
                <capability>gltf.load</capability>
                <capability>gltf.validate</capability>
                <capability>gltf.optimize</capability>
                <capability>gltf.compress</capability>
            </capabilities>
        </plugin>
    </plugins>

