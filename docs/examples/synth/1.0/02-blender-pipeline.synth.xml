                                <label>Export glTF</label>
                                <size>TOOL_SIZE_LARGE</size>
                                <shortcut>Ctrl+Shift+G</shortcut>
                            </tool>
                            <tool>
                                <id>tool_export_fbx</id>
                                <mcp-tool-name>blender/export/fbx</mcp-tool-name>
                                <icon>layers</icon>
                                <label>Export FBX</label>
                                <size>TOOL_SIZE_SMALL</size>
                            </tool>
                            <tool>
                                <id>tool_export_obj</id>
                                <mcp-tool-name>blender/export/obj</mcp-tool-name>
                                <icon>category</icon>
                                <label>Export OBJ</label>
                                <size>TOOL_SIZE_SMALL</size>
                            </tool>
                        </tools>
                    </group>
                    <group>
                        <id>grp_batch</id>
                        <label>Batch</label>
                        <tools>
                            <tool>
                                <id>tool_batch_export</id>
                                <mcp-tool-name>blender/export/batch</mcp-tool-name>
                                <icon>dynamic_feed</icon>
                                <label>Batch Export</label>
                                <size>TOOL_SIZE_LARGE</size>
                            </tool>
                        </tools>
                    </group>
                </groups>
            </tab>

            <!-- Developer Tab -->
            <tab>
                <id>tab_dev</id>
                <label>Developer</label>
                <icon>code</icon>
                <order>99</order>
                <mcp-server-id>mcp_blender</mcp-server-id>
                <accent-color>#9C27B0</accent-color>
                <is-dev-tab>true</is-dev-tab>
                <groups>
                    <group>
