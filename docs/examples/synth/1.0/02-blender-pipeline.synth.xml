                                    <show-when-selection-type>mesh</show-when-selection-type>
                                    <requires-selection>true</requires-selection>
                                </visibility>
                            </tool>
                            <tool>
                                <id>tool_apply_transform</id>
                                <mcp-tool-name>blender/object/apply_transform</mcp-tool-name>
                                <icon>transform</icon>
                                <label>Apply Transform</label>
                                <size>TOOL_SIZE_SMALL</size>
                            </tool>
                        </tools>
                    </group>
                    <group>
                        <id>grp_render</id>
                        <label>Render</label>
                        <tools>
                            <tool>
                                <id>tool_render_preview</id>
                                <mcp-tool-name>blender/render/preview</mcp-tool-name>
                                <icon>camera</icon>
                                <label>Preview</label>
                                <size>TOOL_SIZE_LARGE</size>
                                <shortcut>F12</shortcut>
                            </tool>
                        </tools>
                    </group>
                </groups>
            </tab>

            <!-- Export Tab -->
            <tab>
                <id>tab_export</id>
                <label>Export</label>
                <icon>file_download</icon>
                <order>2</order>
                <mcp-server-id>mcp_blender</mcp-server-id>
                <accent-color>#4CAF50</accent-color>
                <is-dev-tab>false</is-dev-tab>
                <groups>
                    <group>
                        <id>grp_export_formats</id>
