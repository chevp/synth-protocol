<?xml version="1.0" encoding="UTF-8"?>
<!--
  SYNTH PROJECT FILE FORMAT (.synth)
  Based on synth-protocol (nuna/core.proto, nuna/project.proto)
  XML representation for human-readable project configuration

  Protocol Version: 1.1.0
  Schema: synth-protocol/nuna/*.proto

  Architecture: ClusterNode-based tree structure
  - All content organized as ClusterNodes
  - Bidirectional parent/child links for fast UI navigation
  - Components attach to ClusterNodes for data (ECS pattern)
-->
<synth version="1.0" xmlns="https://chevp.github.io/synth-protocol/schema/synth/1.0">
<project>

    <!-- =================================================================== -->
    <!-- FILE HEADER -->
    <!-- Based on nuna.project.ProjectFileHeader -->
    <!-- =================================================================== -->
    <header>
        <magic>SYNTH</magic>
        <format-version>1</format-version>
        <schema-version>1.0.0</schema-version>
        <created-at>1733400000000</created-at>
        <modified-at>1733400000000</modified-at>
        <compressed>false</compressed>
        <compression-type>NONE</compression-type>
    </header>

    <!-- =================================================================== -->
    <!-- PROJECT ROOT -->
    <!-- Based on nuna.project.Project -->
    <!-- =================================================================== -->
    <metadata>
        <entity-id>
            <uuid>proj_01HXYZ123456789ABCDEF</uuid>
            <version>1</version>
            <created-at>1733400000000</created-at>
            <updated-at>1733400000000</updated-at>
        </entity-id>
        <name>Example Synth Project</name>
        <description>A demonstration project showing the synth-protocol XML structure</description>
        <schema-version>1.0.0</schema-version>
        <settings>
            <default-scene-id>scene_main</default-scene-id>
            <thumbnail-asset-id/>
            <auto-save-enabled>true</auto-save-enabled>
            <auto-save-interval-seconds>300</auto-save-interval-seconds>
            <custom-settings>
                <entry key="theme">dark</entry>
                <entry key="language">en</entry>
            </custom-settings>
        </settings>
        <last-opened-at>1733400000000</last-opened-at>
        <last-opened-by>developer</last-opened-by>
    </metadata>

    <!-- =================================================================== -->
    <!-- MCP SERVER REQUIREMENTS -->
    <!-- Based on nuna.project.McpServerRequirement -->
    <!-- =================================================================== -->
    <mcp-servers>
        <server>
            <entity-id>
                <uuid>mcp_playground</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <server-name>synth-playground</server-name>
            <version>1.0.0</version>
            <required>true</required>
            <source>MARKETPLACE_SOURCE_LOCAL</source>
            <config>
                <parameters>
                    <entry key="port">8080</entry>
                    <entry key="host">localhost</entry>
                </parameters>
                <auto-start>true</auto-start>
                <startup-timeout-ms>30000</startup-timeout-ms>
                <health-check-interval-ms>30000</health-check-interval-ms>
            </config>
        </server>
        <server>
            <entity-id>
                <uuid>mcp_vision</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <server-name>synth-vision</server-name>
            <version>1.0.0</version>
            <required>false</required>
            <source>MARKETPLACE_SOURCE_DEV</source>
            <config>
                <auto-start>false</auto-start>
            </config>
        </server>
    </mcp-servers>

    <!-- =================================================================== -->
    <!-- PLUGIN REQUIREMENTS -->
    <!-- Based on nuna.project.PluginRequirement -->
    <!-- =================================================================== -->
    <plugins>
        <plugin>
            <entity-id>
                <uuid>plugin_builtin</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <artifact>io.synth.playground:builtin-tools:1.0.0</artifact>
            <type>PLUGIN_TYPE_JAR</type>
            <source>MARKETPLACE_SOURCE_PRODUCTION</source>
            <mcp-bridge-server-id>mcp_playground</mcp-bridge-server-id>
            <provides-mcp-server>false</provides-mcp-server>
        </plugin>
    </plugins>

    <!-- =================================================================== -->
    <!-- RIBBON CONFIGURATION -->
    <!-- Based on nuna.project.RibbonConfiguration -->
    <!-- =================================================================== -->
    <ribbon>
        <tabs>
            <tab>
                <id>tab_home</id>
                <label>Home</label>
                <icon>home</icon>
                <order>0</order>
                <accent-color>#2196F3</accent-color>
                <is-dev-tab>false</is-dev-tab>
                <groups>
                    <group>
                        <id>grp_file</id>
                        <label>File</label>
                        <tools>
                            <tool>
                                <id>tool_save</id>
                                <mcp-tool-name>playground/save</mcp-tool-name>
                                <icon>save</icon>
                                <label>Save</label>
                                <size>TOOL_SIZE_LARGE</size>
                                <shortcut>Ctrl+S</shortcut>
                            </tool>
                            <tool>
                                <id>tool_open</id>
                                <mcp-tool-name>playground/open</mcp-tool-name>
                                <icon>folder_open</icon>
                                <label>Open</label>
                                <size>TOOL_SIZE_LARGE</size>
                                <shortcut>Ctrl+O</shortcut>
                            </tool>
                        </tools>
                    </group>
                </groups>
            </tab>
            <tab>
                <id>tab_documents</id>
                <label>Documents</label>
                <icon>description</icon>
                <order>1</order>
                <mcp-server-id>mcp_playground</mcp-server-id>
                <accent-color>#4CAF50</accent-color>
                <is-dev-tab>false</is-dev-tab>
                <groups>
                    <group>
                        <id>grp_edit</id>
                        <label>Edit</label>
                        <tools>
                            <tool>
                                <id>tool_edit</id>
                                <mcp-tool-name>document/edit</mcp-tool-name>
                                <icon>edit</icon>
                                <label>Edit</label>
                                <size>TOOL_SIZE_SMALL</size>
                                <shortcut>F2</shortcut>
                                <visibility>
                                    <show-when-selection-type>document</show-when-selection-type>
                                    <requires-selection>true</requires-selection>
                                    <min-selection-count>1</min-selection-count>
                                    <max-selection-count>1</max-selection-count>
                                </visibility>
                            </tool>
                            <tool>
                                <id>tool_delete</id>
                                <mcp-tool-name>document/delete</mcp-tool-name>
                                <icon>delete</icon>
                                <label>Delete</label>
                                <size>TOOL_SIZE_SMALL</size>
                                <shortcut>Delete</shortcut>
                                <visibility>
                                    <requires-selection>true</requires-selection>
                                </visibility>
                            </tool>
                        </tools>
                    </group>
                </groups>
            </tab>
            <tab>
                <id>tab_dev</id>
                <label>Developer</label>
                <icon>code</icon>
                <order>99</order>
                <mcp-server-id>mcp_playground</mcp-server-id>
                <accent-color>#FF9800</accent-color>
                <is-dev-tab>true</is-dev-tab>
                <groups>
                    <group>
                        <id>grp_tools</id>
                        <label>Tools</label>
                        <tools>
                            <tool>
                                <id>tool_info</id>
                                <mcp-tool-name>playground/info</mcp-tool-name>
                                <icon>info</icon>
                                <label>Server Info</label>
                                <size>TOOL_SIZE_SMALL</size>
                                <shortcut>F1</shortcut>
                            </tool>
                            <tool>
                                <id>tool_echo</id>
                                <mcp-tool-name>playground/echo</mcp-tool-name>
                                <icon>chat</icon>
                                <label>Echo Test</label>
                                <size>TOOL_SIZE_SMALL</size>
                            </tool>
                        </tools>
                    </group>
                </groups>
            </tab>
        </tabs>
    </ribbon>

    <!-- =================================================================== -->
    <!-- TAGS -->
    <!-- Based on nuna.core.Tag -->
    <!-- =================================================================== -->
    <tags>
        <tag>
            <entity-id>
                <uuid>tag_important</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>Important</name>
            <color>#FF5722</color>
            <category>priority</category>
        </tag>
        <tag>
            <entity-id>
                <uuid>tag_draft</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>Draft</name>
            <color>#9E9E9E</color>
            <category>status</category>
        </tag>
        <tag>
            <entity-id>
                <uuid>tag_approved</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>Approved</name>
            <color>#4CAF50</color>
            <category>status</category>
        </tag>
        <tag>
            <entity-id>
                <uuid>tag_review</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>Needs Review</name>
            <color>#FFC107</color>
            <category>status</category>
        </tag>
    </tags>

    <!-- =================================================================== -->
    <!-- CLUSTER NODES -->
    <!-- Based on nuna.core.ClusterNode -->
    <!-- Unified tree structure: Project -> Scene -> Folders/Documents -->
    <!-- =================================================================== -->
    <cluster-nodes>
        <!-- Scene node (was separate Scene message) -->
        <node>
            <entity-id>
                <uuid>scene_main</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>Main Scene</name>
            <node-type>CLUSTER_NODE_TYPE_SCENE</node-type>
            <state>CLUSTER_NODE_STATE_ACTIVE</state>
            <child-ids>
                <id>doc_readme</id>
                <id>doc_notes</id>
                <id>folder_docs</id>
            </child-ids>
            <sibling-order>0</sibling-order>
        </node>

        <!-- Folder node -->
        <node>
            <entity-id>
                <uuid>folder_docs</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>Documentation</name>
            <node-type>CLUSTER_NODE_TYPE_FOLDER</node-type>
            <state>CLUSTER_NODE_STATE_ACTIVE</state>
            <parent-id>scene_main</parent-id>
            <child-ids>
                <id>doc_spec</id>
            </child-ids>
            <sibling-order>2</sibling-order>
            <tag-ids>
                <id>tag_important</id>
            </tag-ids>
        </node>

        <!-- Document nodes -->
        <node>
            <entity-id>
                <uuid>doc_readme</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>README.md</name>
            <node-type>CLUSTER_NODE_TYPE_DOCUMENT</node-type>
            <state>CLUSTER_NODE_STATE_ACTIVE</state>
            <parent-id>scene_main</parent-id>
            <sibling-order>0</sibling-order>
            <tag-ids>
                <id>tag_important</id>
                <id>tag_approved</id>
            </tag-ids>
            <metadata>
                <entry key="format">markdown</entry>
                <entry key="mime_type">text/markdown</entry>
            </metadata>
        </node>

        <node>
            <entity-id>
                <uuid>doc_notes</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>Project Notes</name>
            <node-type>CLUSTER_NODE_TYPE_DOCUMENT</node-type>
            <state>CLUSTER_NODE_STATE_ACTIVE</state>
            <parent-id>scene_main</parent-id>
            <sibling-order>1</sibling-order>
            <tag-ids>
                <id>tag_draft</id>
            </tag-ids>
            <metadata>
                <entry key="format">text</entry>
                <entry key="mime_type">text/plain</entry>
            </metadata>
        </node>

        <node>
            <entity-id>
                <uuid>doc_spec</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>Specification</name>
            <node-type>CLUSTER_NODE_TYPE_DOCUMENT</node-type>
            <state>CLUSTER_NODE_STATE_ACTIVE</state>
            <parent-id>folder_docs</parent-id>
            <sibling-order>0</sibling-order>
            <tag-ids>
                <id>tag_important</id>
                <id>tag_review</id>
            </tag-ids>
            <metadata>
                <entry key="format">markdown</entry>
                <entry key="mime_type">text/markdown</entry>
            </metadata>
        </node>
    </cluster-nodes>

    <!-- =================================================================== -->
    <!-- COMPONENTS -->
    <!-- Based on nuna.core.Component -->
    <!-- Text content stored as components with Base64 encoding -->
    <!-- =================================================================== -->
    <components>
        <!-- Scene settings component (attached to scene_main) -->
        <component>
            <entity-id>
                <uuid>comp_scene_settings</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <cluster-node-id>scene_main</cluster-node-id>
            <component-type>scene_settings</component-type>
            <state>COMPONENT_STATE_ENABLED</state>
            <schema-version>1.0.0</schema-version>
            <data encoding="json">{
                "gravity": {"x": 0, "y": -9.81, "z": 0},
                "activeSystemIds": ["sys_text_editor"],
                "description": "The primary scene containing all documents"
            }</data>
        </component>

        <!-- README.md header image (Base64 encoded PNG) -->
        <component>
            <entity-id>
                <uuid>comp_readme_image</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <cluster-node-id>doc_readme</cluster-node-id>
            <component-type>image_content</component-type>
            <state>COMPONENT_STATE_ENABLED</state>
            <schema-version>1.0.0</schema-version>
            <!-- Small 32x32 Cryo icon placeholder (blue gradient) -->
            <data encoding="base64" mime-type="image/png" byte-size="232"></data>
        </component>

        <!-- README.md content (Base64 encoded) - includes image reference ![alt](assets/header.png) -->
        <component>
            <entity-id>
                <uuid>comp_readme_text</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <cluster-node-id>doc_readme</cluster-node-id>
            <component-type>text_content</component-type>
            <state>COMPONENT_STATE_ENABLED</state>
            <schema-version>1.0.0</schema-version>
            <data encoding="base64" original-encoding="UTF-8" mime-type="text/markdown" byte-size="571"></data>
        </component>

        <!-- Project Notes content (Base64 encoded) -->
        <component>
            <entity-id>
                <uuid>comp_notes_text</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <cluster-node-id>doc_notes</cluster-node-id>
            <component-type>text_content</component-type>
            <state>COMPONENT_STATE_ENABLED</state>
            <schema-version>1.0.0</schema-version>
            <data encoding="base64" original-encoding="UTF-8" mime-type="text/plain" byte-size="456"></data>
        </component>

        <!-- Specification content (Base64 encoded) -->
        <component>
            <entity-id>
                <uuid>comp_spec_text</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <cluster-node-id>doc_spec</cluster-node-id>
            <component-type>text_content</component-type>
            <state>COMPONENT_STATE_ENABLED</state>
            <schema-version>1.0.0</schema-version>
            <data encoding="base64" original-encoding="UTF-8" mime-type="text/markdown" byte-size="1156"></data>
        </component>
    </components>

    <!-- =================================================================== -->
    <!-- ASSETS -->
    <!-- Based on nuna.project.Asset -->
    <!-- =================================================================== -->
    <assets>
        <asset>
            <entity-id>
                <uuid>asset_icon</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>project-icon</name>
            <type>ASSET_TYPE_TEXTURE</type>
            <source-path>./assets/icon.png</source-path>
            <uri>asset://project/assets/icon.png</uri>
            <size-bytes>4096</size-bytes>
            <checksum>e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855</checksum>
            <metadata>
                <entry key="width">256</entry>
                <entry key="height">256</entry>
                <entry key="format">PNG</entry>
            </metadata>
        </asset>
        <asset>
            <entity-id>
                <uuid>asset_header</uuid>
                <version>1</version>
                <created-at>1733400000000</created-at>
                <updated-at>1733400000000</updated-at>
            </entity-id>
            <name>header.png</name>
            <type>ASSET_TYPE_TEXTURE</type>
            <source-path>./assets/header.png</source-path>
            <uri>asset://project/assets/header.png</uri>
            <size-bytes>232</size-bytes>
            <checksum>a1b2c3d4e5f6789012345678901234567890abcdef</checksum>
            <metadata>
                <entry key="width">32</entry>
                <entry key="height">32</entry>
                <entry key="format">PNG</entry>
                <entry key="referencedBy">doc_readme</entry>
            </metadata>
        </asset>
    </assets>

</project>
</synth>
