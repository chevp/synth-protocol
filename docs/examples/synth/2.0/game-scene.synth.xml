<?xml version="1.0" encoding="UTF-8"?>
<!--
  SYNTH 2.0 GAME SCENE FORMAT
  Based on nuna-sdk-cpp Unified Processor Architecture

  New in 2.0:
  - Processor pipeline definitions (runtime + editor)
  - Job system configuration (I/O, Compute, Dedicated pools)
  - Worker thread configuration per platform
  - Visual comparison for migration verification

  Schema Version: 2.0.0
-->
<synth version="1.0" xmlns="https://chevp.github.io/synth-protocol/schema/synth/1.0">
<project>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- PROJECT HEADER -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <header>
        <magic>SYNTH</magic>
        <format-version>2</format-version>
        <schema-version>2.0.0</schema-version>
        <created-at>1738800000000</created-at>
        <modified-at>1738800000000</modified-at>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- PROJECT METADATA -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <metadata>
        <entity-id>
            <uuid>proj_game_rpg_demo</uuid>
            <version>1</version>
        </entity-id>
        <name>RPG Demo Scene</name>
        <description>Example game scene demonstrating processors, jobs and worker threads</description>
        <settings>
            <default-scene-id>scene_village</default-scene-id>
            <target-fps>60</target-fps>
            <studio-mode>false</studio-mode>
            <auto-save-enabled>true</auto-save-enabled>
            <auto-save-interval-seconds>300</auto-save-interval-seconds>
        </settings>
    </metadata>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- RUNTIME CONFIGURATION (NEW in 2.0) -->
    <!-- Thread pools, job queues, processor pipeline -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <runtime-configuration>

        <!-- Worker Thread Pools -->
        <thread-pools>
            <!-- I/O Pool: File loading, SQLite, Network -->
            <pool id="io_pool" type="IO">
                <threads platform="desktop_16core">4</threads>
                <threads platform="desktop_8core">2</threads>
                <threads platform="android_highend">2</threads>
                <threads platform="android_midrange">1</threads>
                <queue-size>256</queue-size>
            </pool>

            <!-- Compute Pool: Mesh optimization, texture compression, physics -->
            <pool id="compute_pool" type="COMPUTE">
                <threads platform="desktop_16core">8</threads>
                <threads platform="desktop_8core">4</threads>
                <threads platform="android_highend">4</threads>
                <threads platform="android_midrange">2</threads>
                <queue-size>128</queue-size>
            </pool>

            <!-- Dedicated Threads: Audio, Network realtime -->
            <pool id="dedicated_pool" type="DEDICATED">
                <thread id="audio_thread" affinity="high_priority"/>
                <thread id="network_thread" affinity="normal"/>
            </pool>
        </thread-pools>

        <!-- Job Definitions -->
        <jobs>
            <!-- Asset Loading Jobs (I/O Pool) -->
            <job id="GltfLoadJob" pool="io_pool" priority="HIGH">
                <description>Load and parse GLTF/GLB files</description>
                <submit-processor>SceneLoadOrchestratorProcessor</submit-processor>
                <result-processor>AssetLoadResultProcessor</result-processor>
                <estimated-duration-ms>10-500</estimated-duration-ms>
            </job>

            <job id="TextureDecodeJob" pool="io_pool" priority="HIGH">
                <description>Decode PNG/JPG to raw pixels</description>
                <submit-processor>SceneLoadOrchestratorProcessor</submit-processor>
                <result-processor>AssetLoadResultProcessor</result-processor>
                <estimated-duration-ms>5-50</estimated-duration-ms>
            </job>

            <job id="AudioDecodeJob" pool="io_pool" priority="NORMAL">
                <description>Decode OGG/WAV to PCM</description>
                <submit-processor>SceneLoadOrchestratorProcessor</submit-processor>
                <result-processor>AssetLoadResultProcessor</result-processor>
                <estimated-duration-ms>10-100</estimated-duration-ms>
            </job>

            <!-- Editor Persistence Jobs (I/O Pool, Low Priority) -->
            <job id="AutoSaveJob" pool="io_pool" priority="LOW">
                <description>Serialize scene to temp file</description>
                <submit-processor>AutoSaveProcessor</submit-processor>
                <result-processor>StatusBarProcessor</result-processor>
                <estimated-duration-ms>10-200</estimated-duration-ms>
            </job>

            <job id="SceneSaveJob" pool="io_pool" priority="NORMAL">
                <description>Save scene to .synth file</description>
                <submit-processor>SceneSaveProcessor</submit-processor>
                <result-processor>StatusBarProcessor</result-processor>
                <estimated-duration-ms>10-200</estimated-duration-ms>
            </job>

            <!-- Database Jobs (I/O Pool) -->
            <job id="AssetCacheWriteJob" pool="io_pool" priority="LOW">
                <description>Write asset to SQLite cache</description>
                <submit-processor>GpuUploadProcessor</submit-processor>
                <fire-and-forget>true</fire-and-forget>
            </job>

            <!-- Compute Jobs (Compute Pool) -->
            <job id="MeshOptimizeJob" pool="compute_pool" priority="NORMAL">
                <description>Optimize mesh with meshoptimizer</description>
                <submit-processor>SceneLoadOrchestratorProcessor</submit-processor>
                <result-processor>AssetLoadResultProcessor</result-processor>
                <estimated-duration-ms>50-500</estimated-duration-ms>
            </job>

            <job id="NavMeshBuildJob" pool="compute_pool" priority="BACKGROUND">
                <description>Generate navigation mesh</description>
                <submit-processor>EditorMenuBarProcessor</submit-processor>
                <result-processor>StatusBarProcessor</result-processor>
                <estimated-duration-ms>500-5000</estimated-duration-ms>
            </job>

            <job id="PhysicsColliderBakeJob" pool="compute_pool" priority="NORMAL">
                <description>Bake mesh to collision shape</description>
                <submit-processor>SceneLoadOrchestratorProcessor</submit-processor>
                <result-processor>AssetLoadResultProcessor</result-processor>
                <estimated-duration-ms>50-500</estimated-duration-ms>
            </job>
        </jobs>

        <!-- Processor Pipeline Configuration -->
        <processors>
            <!-- Runtime Processors (Order 0-999) - Always active -->
            <stage name="Input" order-range="0-49">
                <processor order="10" name="PlatformEventProcessor" enabled="true"/>
                <processor order="20" name="InputMappingProcessor" enabled="true"/>
                <processor order="30" name="GestureRecognitionProcessor" enabled="true"/>
                <processor order="40" name="InputBufferProcessor" enabled="true"/>
            </stage>

            <stage name="Data" order-range="50-99">
                <processor order="50" name="DatabaseConnectProcessor" enabled="true"/>
                <processor order="60" name="PendingWriteProcessor" enabled="true"/>
                <processor order="70" name="AssetCacheCheckProcessor" enabled="true"/>
                <processor order="80" name="ConfigLoadProcessor" enabled="true"/>
                <processor order="90" name="StatePersistProcessor" enabled="true"/>
                <processor order="95" name="JobSchedulerProcessor" enabled="true"/>
                <processor order="96" name="AssetLoadResultProcessor" enabled="true"/>
                <processor order="97" name="SceneLoadOrchestratorProcessor" enabled="true"/>
            </stage>

            <stage name="Network" order-range="100-199">
                <processor order="100" name="NetworkReceiveProcessor" enabled="true"/>
                <processor order="110" name="ProtocolDecodeProcessor" enabled="true"/>
                <processor order="120" name="StateReconcileProcessor" enabled="true"/>
                <processor order="180" name="NetworkSendProcessor" enabled="true"/>
                <processor order="190" name="LatencyTrackProcessor" enabled="true"/>
            </stage>

            <stage name="GameLogic" order-range="200-299">
                <processor order="200" name="StateMachineProcessor" enabled="true"/>
                <processor order="210" name="CommandExecuteProcessor" enabled="true"/>
                <processor order="220" name="MovementProcessor" enabled="true"/>
                <processor order="230" name="CollisionProcessor" enabled="true"/>
                <processor order="240" name="InteractionProcessor" enabled="true"/>
                <processor order="250" name="InventoryProcessor" enabled="true"/>
                <processor order="260" name="QuestProcessor" enabled="true"/>
                <processor order="270" name="AIProcessor" enabled="true"/>
                <processor order="280" name="TriggerProcessor" enabled="true"/>
            </stage>

            <stage name="Physics" order-range="300-399">
                <processor order="300" name="PhysicsStepProcessor" enabled="true">
                    <config>
                        <entry key="fixedTimestep">0.016666</entry>
                        <entry key="maxSubsteps">4</entry>
                        <entry key="gravity">0,-9.81,0</entry>
                    </config>
                </processor>
                <processor order="310" name="RigidBodyProcessor" enabled="true"/>
                <processor order="320" name="CharacterControllerProcessor" enabled="true"/>
                <processor order="330" name="RaycastProcessor" enabled="true"/>
                <processor order="380" name="PhysicsSyncProcessor" enabled="true"/>
            </stage>

            <stage name="Animation" order-range="400-499">
                <processor order="400" name="AnimationUpdateProcessor" enabled="true"/>
                <processor order="410" name="AnimationBlendProcessor" enabled="true"/>
                <processor order="420" name="IKProcessor" enabled="true"/>
                <processor order="450" name="SkinningProcessor" enabled="true"/>
                <processor order="460" name="MorphTargetProcessor" enabled="true"/>
            </stage>

            <stage name="Scene" order-range="500-599">
                <processor order="500" name="SceneGraphUpdateProcessor" enabled="true"/>
                <processor order="510" name="TransformProcessor" enabled="true"/>
                <processor order="520" name="BoundingVolumeProcessor" enabled="true"/>
                <processor order="530" name="FrustumCullProcessor" enabled="true"/>
                <processor order="540" name="LODSelectProcessor" enabled="true"/>
                <processor order="580" name="RenderListProcessor" enabled="true"/>
                <processor order="598" name="GpuUploadProcessor" enabled="true"/>
            </stage>

            <stage name="Render" order-range="600-799">
                <processor order="600" name="FrameBeginProcessor" enabled="true"/>
                <processor order="610" name="CommandBufferBeginProcessor" enabled="true"/>
                <processor order="620" name="ShadowMapProcessor" enabled="true">
                    <config>
                        <entry key="resolution">2048</entry>
                        <entry key="cascadeCount">4</entry>
                    </config>
                </processor>
                <processor order="630" name="DepthPrepassProcessor" enabled="true"/>
                <processor order="660" name="ForwardOpaqueProcessor" enabled="true"/>
                <processor order="670" name="SkyboxProcessor" enabled="true"/>
                <processor order="680" name="TransparentProcessor" enabled="true"/>
                <processor order="690" name="ParticleProcessor" enabled="true"/>
                <processor order="700" name="BloomProcessor" enabled="true">
                    <config>
                        <entry key="threshold">1.0</entry>
                        <entry key="intensity">0.5</entry>
                    </config>
                </processor>
                <processor order="710" name="SSAOProcessor" enabled="true"/>
                <processor order="730" name="TonemapProcessor" enabled="true">
                    <config>
                        <entry key="exposure">1.0</entry>
                        <entry key="gamma">2.2</entry>
                    </config>
                </processor>
                <processor order="740" name="FXAAProcessor" enabled="true"/>
                <processor order="750" name="ImGuiNewFrameProcessor" enabled="true"/>
                <processor order="760" name="GameUIProcessor" enabled="true"/>
                <processor order="765" name="DebugOverlayProcessor" enabled="false"/>
                <processor order="778" name="ImGuiRenderProcessor" enabled="true"/>
                <processor order="779" name="ImGuiSubmitProcessor" enabled="true"/>
                <processor order="780" name="CommandBufferEndProcessor" enabled="true"/>
                <processor order="790" name="QueueSubmitProcessor" enabled="true"/>
                <processor order="795" name="PresentProcessor" enabled="true"/>
            </stage>

            <stage name="Audio" order-range="800-899">
                <processor order="800" name="AudioUpdateProcessor" enabled="true"/>
                <processor order="810" name="Audio3DProcessor" enabled="true"/>
                <processor order="820" name="AudioMixProcessor" enabled="true"/>
                <processor order="880" name="AudioSubmitProcessor" enabled="true"/>
            </stage>

            <stage name="Cleanup" order-range="900-999">
                <processor order="900" name="FrameStatsProcessor" enabled="true"/>
                <processor order="910" name="MemoryResetProcessor" enabled="true"/>
                <processor order="920" name="ResourceGCProcessor" enabled="true"/>
                <processor order="990" name="FrameEndProcessor" enabled="true"/>
            </stage>

            <!-- Editor Processors (Order 1000-1999) - Only when studio-mode=true -->
            <stage name="EditorInput" order-range="1000-1049" requires-studio-mode="true">
                <processor order="1000" name="EditorCameraProcessor" enabled="true"/>
                <processor order="1010" name="EditorHotkeyProcessor" enabled="true"/>
                <processor order="1020" name="EditorMousePickProcessor" enabled="true"/>
                <processor order="1030" name="EditorDragDropProcessor" enabled="true"/>
            </stage>

            <stage name="EditorLogic" order-range="1050-1099" requires-studio-mode="true">
                <processor order="1050" name="SelectionProcessor" enabled="true"/>
                <processor order="1060" name="UndoRedoProcessor" enabled="true"/>
                <processor order="1070" name="CopyPasteProcessor" enabled="true"/>
                <processor order="1080" name="TransformEditProcessor" enabled="true"/>
            </stage>

            <stage name="EditorScene" order-range="1100-1149" requires-studio-mode="true">
                <processor order="1100" name="GridProcessor" enabled="true"/>
                <processor order="1110" name="GizmoProcessor" enabled="true"/>
                <processor order="1120" name="BoundsVisualizerProcessor" enabled="true"/>
                <processor order="1130" name="LightVisualizerProcessor" enabled="true"/>
                <processor order="1140" name="CameraPreviewProcessor" enabled="true"/>
            </stage>

            <stage name="EditorUI" order-range="1200-1299" requires-studio-mode="true">
                <processor order="1200" name="EditorMenuBarProcessor" enabled="true"/>
                <processor order="1210" name="SceneHierarchyProcessor" enabled="true"/>
                <processor order="1220" name="InspectorProcessor" enabled="true"/>
                <processor order="1230" name="AssetBrowserProcessor" enabled="true"/>
                <processor order="1240" name="ConsoleProcessor" enabled="true"/>
                <processor order="1250" name="ViewportToolbarProcessor" enabled="true"/>
                <processor order="1260" name="StatusBarProcessor" enabled="true"/>
            </stage>

            <stage name="EditorPersistence" order-range="1300-1349" requires-studio-mode="true">
                <processor order="1300" name="SceneSaveProcessor" enabled="true"/>
                <processor order="1310" name="SceneLoadProcessor" enabled="true"/>
                <processor order="1320" name="AutoSaveProcessor" enabled="true">
                    <config>
                        <entry key="intervalMinutes">5</entry>
                        <entry key="maxBackups">3</entry>
                    </config>
                </processor>
                <processor order="1330" name="ProjectSettingsProcessor" enabled="true"/>
            </stage>

            <stage name="EditorPlayMode" order-range="1400-1449" requires-studio-mode="true">
                <processor order="1400" name="PlayModeProcessor" enabled="true"/>
                <processor order="1410" name="PlayModeStateProcessor" enabled="true"/>
                <processor order="1420" name="PlayModePauseProcessor" enabled="true"/>
            </stage>
        </processors>

    </runtime-configuration>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- SCENE HIERARCHY -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <cluster-nodes>
        <!-- Scene Root -->
        <node>
            <entity-id>
                <uuid>scene_village</uuid>
                <version>1</version>
            </entity-id>
            <name>Village Scene</name>
            <node-type>CLUSTER_NODE_TYPE_SCENE</node-type>
            <child-ids>
                <id>entity_environment</id>
                <id>entity_player</id>
                <id>entity_npc_merchant</id>
                <id>entity_lights</id>
                <id>entity_audio</id>
            </child-ids>
        </node>

        <!-- Environment Group -->
        <node>
            <entity-id>
                <uuid>entity_environment</uuid>
                <version>1</version>
            </entity-id>
            <name>Environment</name>
            <node-type>CLUSTER_NODE_TYPE_FOLDER</node-type>
            <parent-id>scene_village</parent-id>
            <child-ids>
                <id>entity_terrain</id>
                <id>entity_building_tavern</id>
                <id>entity_building_shop</id>
                <id>entity_trees</id>
            </child-ids>
        </node>

        <!-- Terrain -->
        <node>
            <entity-id>
                <uuid>entity_terrain</uuid>
                <version>1</version>
            </entity-id>
            <name>Terrain</name>
            <node-type>CLUSTER_NODE_TYPE_ENTITY</node-type>
            <parent-id>entity_environment</parent-id>
        </node>

        <!-- Player Entity -->
        <node>
            <entity-id>
                <uuid>entity_player</uuid>
                <version>1</version>
            </entity-id>
            <name>Player</name>
            <node-type>CLUSTER_NODE_TYPE_ENTITY</node-type>
            <parent-id>scene_village</parent-id>
            <tag-ids>
                <id>tag_controllable</id>
                <id>tag_persistent</id>
            </tag-ids>
        </node>

        <!-- NPC -->
        <node>
            <entity-id>
                <uuid>entity_npc_merchant</uuid>
                <version>1</version>
            </entity-id>
            <name>Merchant NPC</name>
            <node-type>CLUSTER_NODE_TYPE_ENTITY</node-type>
            <parent-id>scene_village</parent-id>
            <tag-ids>
                <id>tag_npc</id>
                <id>tag_interactable</id>
            </tag-ids>
        </node>

        <!-- Lights -->
        <node>
            <entity-id>
                <uuid>entity_lights</uuid>
                <version>1</version>
            </entity-id>
            <name>Lights</name>
            <node-type>CLUSTER_NODE_TYPE_FOLDER</node-type>
            <parent-id>scene_village</parent-id>
            <child-ids>
                <id>entity_sun</id>
                <id>entity_torch_1</id>
            </child-ids>
        </node>

        <node>
            <entity-id>
                <uuid>entity_sun</uuid>
                <version>1</version>
            </entity-id>
            <name>Sun Light</name>
            <node-type>CLUSTER_NODE_TYPE_ENTITY</node-type>
            <parent-id>entity_lights</parent-id>
        </node>
    </cluster-nodes>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- COMPONENTS (ECS Data) -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <components>
        <!-- Player Transform -->
        <component>
            <entity-id>
                <uuid>comp_player_transform</uuid>
                <version>1</version>
            </entity-id>
            <cluster-node-id>entity_player</cluster-node-id>
            <component-type>transform</component-type>
            <data encoding="json">{
                "position": {"x": 0, "y": 0, "z": 0},
                "rotation": {"x": 0, "y": 0, "z": 0, "w": 1},
                "scale": {"x": 1, "y": 1, "z": 1}
            }</data>
        </component>

        <!-- Player Mesh Renderer (references GLTF asset) -->
        <component>
            <entity-id>
                <uuid>comp_player_mesh</uuid>
                <version>1</version>
            </entity-id>
            <cluster-node-id>entity_player</cluster-node-id>
            <component-type>mesh_renderer</component-type>
            <data encoding="json">{
                "meshAssetId": "asset_player_model",
                "castShadows": true,
                "receiveShadows": true
            }</data>
        </component>

        <!-- Player Animation -->
        <component>
            <entity-id>
                <uuid>comp_player_animation</uuid>
                <version>1</version>
            </entity-id>
            <cluster-node-id>entity_player</cluster-node-id>
            <component-type>animator</component-type>
            <data encoding="json">{
                "animationAssetId": "asset_player_model",
                "currentAnimation": "idle",
                "blendTime": 0.2
            }</data>
        </component>

        <!-- Player Character Controller -->
        <component>
            <entity-id>
                <uuid>comp_player_controller</uuid>
                <version>1</version>
            </entity-id>
            <cluster-node-id>entity_player</cluster-node-id>
            <component-type>character_controller</component-type>
            <data encoding="json">{
                "height": 1.8,
                "radius": 0.3,
                "stepOffset": 0.3,
                "slopeLimit": 45
            }</data>
        </component>

        <!-- Sun Light Component -->
        <component>
            <entity-id>
                <uuid>comp_sun_light</uuid>
                <version>1</version>
            </entity-id>
            <cluster-node-id>entity_sun</cluster-node-id>
            <component-type>directional_light</component-type>
            <data encoding="json">{
                "color": {"r": 1.0, "g": 0.95, "b": 0.9},
                "intensity": 1.5,
                "direction": {"x": 0.5, "y": -1, "z": 0.3},
                "castShadows": true,
                "shadowCascades": 4,
                "shadowResolution": 2048
            }</data>
        </component>

        <!-- NPC AI Component -->
        <component>
            <entity-id>
                <uuid>comp_npc_ai</uuid>
                <version>1</version>
            </entity-id>
            <cluster-node-id>entity_npc_merchant</cluster-node-id>
            <component-type>npc_behavior</component-type>
            <data encoding="json">{
                "behaviorTree": "bt_merchant",
                "dialogueId": "dialogue_merchant_greeting",
                "wanderRadius": 5.0,
                "interactionRadius": 2.0
            }</data>
        </component>
    </components>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- ASSETS -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <assets>
        <asset>
            <entity-id>
                <uuid>asset_player_model</uuid>
                <version>1</version>
            </entity-id>
            <name>Player Character</name>
            <type>ASSET_TYPE_MODEL</type>
            <source-path>./assets/models/player.glb</source-path>
            <uri>asset://project/models/player.glb</uri>
            <metadata>
                <entry key="format">GLTF_BINARY</entry>
                <entry key="hasAnimations">true</entry>
                <entry key="hasSkinning">true</entry>
                <entry key="vertexCount">12500</entry>
                <entry key="triangleCount">8200</entry>
            </metadata>
            <!-- Job that will load this asset -->
            <load-job>GltfLoadJob</load-job>
        </asset>

        <asset>
            <entity-id>
                <uuid>asset_terrain</uuid>
                <version>1</version>
            </entity-id>
            <name>Village Terrain</name>
            <type>ASSET_TYPE_MODEL</type>
            <source-path>./assets/models/terrain_village.glb</source-path>
            <uri>asset://project/models/terrain_village.glb</uri>
            <metadata>
                <entry key="hasCollider">true</entry>
                <entry key="colliderType">mesh</entry>
            </metadata>
            <load-job>GltfLoadJob</load-job>
            <post-load-job>PhysicsColliderBakeJob</post-load-job>
        </asset>

        <asset>
            <entity-id>
                <uuid>asset_ambient_music</uuid>
                <version>1</version>
            </entity-id>
            <name>Village Ambient</name>
            <type>ASSET_TYPE_AUDIO</type>
            <source-path>./assets/audio/ambient_village.ogg</source-path>
            <uri>asset://project/audio/ambient_village.ogg</uri>
            <metadata>
                <entry key="format">OGG_VORBIS</entry>
                <entry key="loop">true</entry>
                <entry key="channels">2</entry>
            </metadata>
            <load-job>AudioDecodeJob</load-job>
        </asset>
    </assets>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- TAGS -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <tags>
        <tag>
            <entity-id><uuid>tag_controllable</uuid></entity-id>
            <name>Controllable</name>
            <color>#2196F3</color>
            <category>gameplay</category>
        </tag>
        <tag>
            <entity-id><uuid>tag_persistent</uuid></entity-id>
            <name>Persistent</name>
            <color>#4CAF50</color>
            <category>system</category>
        </tag>
        <tag>
            <entity-id><uuid>tag_npc</uuid></entity-id>
            <name>NPC</name>
            <color>#FF9800</color>
            <category>gameplay</category>
        </tag>
        <tag>
            <entity-id><uuid>tag_interactable</uuid></entity-id>
            <name>Interactable</name>
            <color>#9C27B0</color>
            <category>gameplay</category>
        </tag>
    </tags>

</project>
</synth>